 src/navi48-bringup/src/accel_fire_at_boot.h   |  88 ++++++
 .../tests/accel_fire_at_boot_plant.sh         | 150 +++++++++
 .../tests/accel_fire_at_boot_test.cpp         | 297 ++++++++++++++++++
 4 files changed, 573 insertions(+), 1 deletion(-)
