+++ b/src/navi48-bringup/src/Navi48Bringup.cpp
@@ -44,6 +44,8 @@
 
 #include "fw/fw_table.h"            // 0.0.664 (Navi 44 part 2): per-die firmware set, selected in probe()
 
+#include "accel_fire_at_boot.h"     // 0017: may this boot run the fire path with no userspace verb?
+
 // 0016 — the stage-17 compute shader, so the Navi 44 gate can report what it is about to
 // let a writing stage upload. Same declaration as src/amd/compute_test.cpp's: C linkage
 // (the blobs are generated .c translation units), namespace-scoped names.
@@ -7756,6 +7758,42 @@ bool Navi48Bringup::start(IOService *provider) {
 			       "to install the TTL hook and let Apple's accelerator match.");
 			setProperty("Navi48,AccelExperiment", "armed — fire with navi48test accel fire");
 		}
+		// 0017: the same fire, from a boot-arg. `navi48test` is a Mach-O userspace binary built on a
+		// Mac, so on a machine whose only macOS is a USB stick the verb does not exist — the card
+		// arms, never fires, and the boot reads as "no GPU acceleration" with nothing wrong in the
+		// hardware path. accel_fire_at_boot.h owns when this may proceed; it refuses instead of
+		// calling, because the fire path installs the TTL hook before its exposure gate can withhold
+		// LoadAccelerator, and a hooked-but-unpublished card is a worse state than an unhired one.
+		// Default OFF: a boot without the arg takes exactly the branch it took before this block.
+		{
+			uint32_t fireAtBoot = 0;
+			PE_parse_boot_argn("navi48-accel-fire-at-boot", &fireAtBoot, sizeof(fireAtBoot));
+			uint32_t gateMode = 1;
+			PE_parse_boot_argn("navi48-accel-gate", &gateMode, sizeof(gateMode));
+
+			n48::AccelFireAtBootFacts ff;
+			ff.argRequested    = fireAtBoot != 0;
+			ff.experimentArmed = accelExperimentArmed;
+			ff.ladderRan       = gBringup.reached != amdgpu::BringupStage::None;
+			ff.selfTestPassed  = gBringup.computePassed &&
+			                     gBringup.reached >= amdgpu::BringupStage::ComputeDispatch;
+			ff.gateMode        = gateMode;
+
+			const char *fwhy = "";
+			const n48::AccelFireAtBoot fv = n48::accel_fire_at_boot_gate(ff, &fwhy);
+			if (ff.argRequested) setProperty("Navi48,AccelFireAtBoot", fwhy);
+			if (fv == n48::AccelFireAtBoot::Call) {
+				uint64_t installed = 0, calls = 0, firstUnsup = 0;
+				const IOReturn fkr = accelExperiment(1 /*fire*/, &installed, &calls, &firstUnsup,
+				                                    nullptr, 0);
+				N48LOG("accel-fire-at-boot: called the fire path — kr %#x, installed %llu, "
+				       "TTL calls %llu (reason: %s)", (unsigned)fkr,
+				       (unsigned long long)installed, (unsigned long long)calls, fwhy);
+				setProperty("Navi48,AccelFireAtBootKr", static_cast<uint64_t>(fkr), 32);
+			} else if (ff.argRequested) {
+				N48LOG("accel-fire-at-boot: %s — the verb path is untouched", fwhy);
+			}
+		}
 		// MILESTONE 3 step 1 (0.0.235): the IH -> Apple completion bridge can be
 		// armed at boot instead of by a verb, which is what makes it part of a
 		// self-driving driver rather than an instrument. Arming is only a flag —
diff --git a/src/navi48-bringup/src/accel_fire_at_boot.h b/src/navi48-bringup/src/accel_fire_at_boot.h
new file mode 100644
index 0000000..3050edf
--- /dev/null
+++ b/src/navi48-bringup/src/accel_fire_at_boot.h
@@ -0,0 +1,88 @@
+#pragma once
+//
+//  accel_fire_at_boot.h — may this boot publish LoadAccelerator with no userspace verb?
+//
+//  RDNA4FB / Navi48Bringup.kext
+//
+//  Scope: a pure decision over facts the kext already holds at the end of start(). Nothing here
+//  reads a register, a boot-arg or IORegistry, and nothing here publishes anything — it only says
+//  whether start() may ask the existing fire path to run.
+//
+//  Why it exists: `LoadAccelerator` is the single property Apple's accelerator personalities match
+//  on, and the only caller that publishes it is the fire path of accelExperiment(), reached from the
+//  userspace verb `navi48test accel fire`. That verb needs a Mach-O binary built on a Mac, so on a
+//  machine whose only macOS is a USB stick the card arms forever and never fires — which is what
+//  "booted, no GPU acceleration" actually was. An opt-in boot-arg removes the dependency for the
+//  first attempt on a new die.
+//
+//  Why it can refuse: the fire path installs the TTL hook BEFORE it consults the exposure gate, and
+//  an installed hook with the property withheld is a half-modified Apple driver stack for the rest
+//  of the boot — worse than not firing. So this gate requires the stage-17 self-test to have passed
+//  rather than trusting the inner gate to say no afterwards.
+//
+
+#include <cstdint>
+
+namespace n48 {
+
+struct AccelFireAtBootFacts {
+    bool     argRequested    = false;  // boot-arg navi48-accel-fire-at-boot=1
+    bool     experimentArmed = false;  // boot-arg navi48-accel-experiment=1 (the existing arm)
+    bool     ladderRan       = false;  // stagePSP()/runStages executed on this boot
+    bool     selfTestPassed  = false;  // the stage-17 compute dispatch passed with every lane checked
+    uint32_t gateMode        = 1;      // navi48-accel-gate: 0 never, 1 self-test, 2 forced open
+};
+
+enum class AccelFireAtBoot {
+    Call,              // ask the existing fire path to run
+    SkipNotRequested,  // default: today's behaviour, unchanged
+    SkipNotArmed,      // no experiment arm => no TTL hook owner, no verb semantics
+    Refuse,            // do not call, and say why
+};
+
+inline const char *accelFireAtBootReason(AccelFireAtBoot v) {
+    switch (v) {
+        case AccelFireAtBoot::Call:             return "allowed";
+        case AccelFireAtBoot::SkipNotRequested: return "navi48-accel-fire-at-boot not set - the verb path is unchanged";
+        case AccelFireAtBoot::SkipNotArmed:     return "navi48-accel-experiment=1 is absent, so nothing owns the TTL hook this would install";
+        case AccelFireAtBoot::Refuse:           break;
+    }
+    return "refused";
+}
+
+inline AccelFireAtBoot accel_fire_at_boot_gate(const AccelFireAtBootFacts &f, const char **reasonOut) {
+    auto verdict = [&](AccelFireAtBoot v, const char *r) {
+        if (reasonOut) *reasonOut = r;
+        return v;
+    };
+
+    if (!f.argRequested)
+        return verdict(AccelFireAtBoot::SkipNotRequested, accelFireAtBootReason(AccelFireAtBoot::SkipNotRequested));
+
+    // The fire path also reads the arm flag itself and refuses, but by then it has already bound the
+    // TTL object; declining here keeps an un-armed boot byte-identical to one that never saw this arg.
+    if (!f.experimentArmed)
+        return verdict(AccelFireAtBoot::SkipNotArmed, accelFireAtBootReason(AccelFireAtBoot::SkipNotArmed));
+
+    // reached < stage 17 means the ladder stopped short of the rung the self-test is defined on, so
+    // `selfTestPassed` below would be a stale false rather than a measured result.
+    if (!f.ladderRan)
+        return verdict(AccelFireAtBoot::Refuse,
+                       "the bring-up ladder never ran this boot (navi48-stage too low, or the PSP chain "
+                       "failed) - there is no self-test result to act on");
+
+    if (!f.selfTestPassed)
+        return verdict(AccelFireAtBoot::Refuse,
+                       "the stage-17 compute dispatch did not pass, and the fire path installs the TTL "
+                       "hook before its exposure gate can withhold LoadAccelerator - a hooked-but-unpublished "
+                       "card is the half-state this path exists to avoid (use `navi48test accel fire` to probe anyway)");
+
+    // gate 0 means "never publish", and that order of the two args is the owner's, not ours to second-guess.
+    if (f.gateMode == 0)
+        return verdict(AccelFireAtBoot::Refuse,
+                       "navi48-accel-gate=0 forbids publishing LoadAccelerator at all this boot");
+
+    return verdict(AccelFireAtBoot::Call, accelFireAtBootReason(AccelFireAtBoot::Call));
+}
+
+}  // namespace n48
diff --git a/src/navi48-bringup/tests/accel_fire_at_boot_plant.sh b/src/navi48-bringup/tests/accel_fire_at_boot_plant.sh
new file mode 100644
index 0000000..99786d6
--- /dev/null
+++ b/src/navi48-bringup/tests/accel_fire_at_boot_plant.sh
@@ -0,0 +1,150 @@
+#!/usr/bin/env bash
+#
+#  accel_fire_at_boot_plant.sh — prove the 0017 suite can actually fail.
+#
+#  Usage (from anywhere):  ZIG=/path/to/zig.exe bash tests/accel_fire_at_boot_plant.sh
+#
+#  One break at a time, planted into a COPY of the real sources, and the suite must catch
+#  it. This gate decides whether a boot hands the card to every Metal client on the machine
+#  with nobody at a keyboard, so the plants are the whole review: five of them remove one
+#  refusal each, and each removal has to make the suite go red.
+#
+#  Rules (same as the other *_plant.sh here):
+#    * needles are SINGLE-LINE, because the checkout is CRLF and a multi-line needle
+#      never matches;
+#    * every needle must be found, or the run aborts - a drifted needle silently
+#      becomes "no plant applied", which reads exactly like a passing suite;
+#    * the pristine checksum is taken up front and re-checked at the end;
+#    * `control` runs the untouched copy first.
+#
+set -u
+
+ZIG="${ZIG:?set ZIG to the zig (or zig c++) driver to use}"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/.." && pwd)"
+SCR="$(mktemp -d)"
+mkdir -p "$SCR" || { echo "cannot make $SCR"; exit 2; }
+trap 'rm -rf "$SCR"' EXIT
+
+cp -R "$ROOT/src" "$SCR/src" || { echo "copy of src failed"; exit 2; }
+cp -R "$ROOT/tests/dalshim" "$SCR/dalshim" 2>/dev/null
+
+PRISTINE=$(find "$SCR/src" -type f \( -name '*.h' -o -name '*.hpp' -o -name '*.cpp' \) \
+    | sort | xargs cat | cksum | awk '{print $1}')
+
+build_run() {
+	# "$ZIG" stays quoted: on this workstation the toolchain path contains spaces, and a
+	# word-split $ZIG fails with "D:\Work: No such file or directory" - which a plant run
+	# reports as a build failure, indistinguishable from a broken source tree.
+	"$ZIG" c++ -std=c++17 -O1 -I "$SCR/dalshim" -I "$SCR/src" \
+		"$HERE/accel_fire_at_boot_test.cpp" -o "$SCR/t" >"$SCR/build.log" 2>&1 || {
+		echo "    BUILD FAILED"; sed -n '1,6p' "$SCR/build.log"; return 2; }
+	"$SCR/t" "$SCR" >"$SCR/run.log" 2>&1
+	return $?
+}
+
+count_matches() { # file needle -> echoes the number of occurrences
+	N="$2" perl -0777 -ne 'my $c = () = $_ =~ /\Q$ENV{N}\E/g; print $c' "$1"
+}
+
+plant() {
+	local file="$1" needle="$2" repl="$3" occ="${4:-1}"
+	local path="$SCR/$file"
+	cp "$ROOT/$file" "$path"                       # always plant from pristine
+	local found
+	found=$(count_matches "$path" "$needle")
+	if [ "${found:-0}" -lt "$occ" ]; then
+		echo "    NEEDLE MISSING (occ $occ of $found): $needle"
+		return 9
+	fi
+	# Counting is done with N="..." perl ... FILE, never with `perl -sne '...' N=...`:
+	# without a preceding --, perl treats N=<needle> as another INPUT FILE, so $ENV{N} is
+	# empty, the regex matches at every position, and both the "needle exists" and the
+	# "plant landed" guards report success no matter what the tree contains.
+	N="$needle" R="$repl" O="$occ" perl -0777 -i -pe '
+		my $n = $ENV{N}; my $r = $ENV{R}; my $want = $ENV{O}; my $i = 0;
+		s/\Q$n\E/$i++; ($i == $want) ? $r : $n/ge;
+	' "$path"
+	local after afterRepl
+	after=$(count_matches "$path" "$needle")
+	afterRepl=$(count_matches "$path" "$repl")
+	if [ "$after" -ge "$occ" ] && [ "${afterRepl:-0}" -eq 0 ]; then
+		echo "    PLANT DID NOT LAND"
+		return 9
+	fi
+	return 0
+}
+
+restore_all() { rm -rf "$SCR/src"; cp -R "$ROOT/src" "$SCR/src"; }
+
+H=src/accel_fire_at_boot.h
+C=src/Navi48Bringup.cpp
+
+declare -a PASS FAIL MISS
+PASSN=0 FAILN=0 MISSN=0
+run_plant() { # LABEL FILE NEEDLE REPL [OCC]
+	local label="$1"; shift
+	printf '  %-46s' "$label"
+	if ! plant "$@"; then echo "PLANT-ERROR"; MISS+=("$label"); MISSN=$((MISSN + 1)); restore_all; return; fi
+	build_run
+	local rc=$?
+	if [ "$rc" -eq 0 ]; then echo "ESCAPED (suite still passed)"; FAIL+=("$label"); FAILN=$((FAILN + 1));
+	else echo "caught (rc=$rc)"; PASS+=("$label"); PASSN=$((PASSN + 1)); fi
+	restore_all
+}
+
+echo "== control: the untouched copy =="
+if build_run; then echo "  control PASSED - plants below are meaningful"
+else echo "  control FAILED - the copy/build step is broken, stopping"; exit 1; fi
+
+echo "== plants: the pure gate (each one removes a refusal) =="
+run_plant "gate: opt-in arg check dropped"     "$H" 'if (!f.argRequested)' 'if (false)'
+run_plant "gate: arm check dropped"            "$H" 'if (!f.experimentArmed)' 'if (false)'
+run_plant "gate: no-ladder check dropped"      "$H" 'if (!f.ladderRan)' 'if (false)'
+run_plant "gate: self-test check dropped"      "$H" 'if (!f.selfTestPassed)' 'if (false)'
+run_plant "gate: gate-0 check dropped"         "$H" 'if (f.gateMode == 0)' 'if (false)'
+run_plant "gate: arm test reads the wrong fact" "$H" 'if (!f.experimentArmed)' 'if (!f.ladderRan)'
+run_plant "gate: refusals all become skips"    "$H" 'return verdict(AccelFireAtBoot::Refuse,' 'return verdict(AccelFireAtBoot::SkipNotArmed,' 2
+run_plant "gate: Call downgraded to skip"      "$H" 'return verdict(AccelFireAtBoot::Call, accelFireAtBootReason(AccelFireAtBoot::Call));' 'return verdict(AccelFireAtBoot::SkipNotRequested, "no");'
+
+echo "== plants: the reason text an owner reads =="
+run_plant "why: half-state loses the TTL word" "$H" 'the fire path installs the TTL "' 'the fire path installs the hook "'
+run_plant "why: no diagnostic route offered"   "$H" '(use `navi48test accel fire` to probe anyway)' '(no alternative offered)'
+run_plant "why: gate-0 stops naming the arg"   "$H" '"navi48-accel-gate=0 forbids' '"the gate forbids'
+run_plant "why: ladder refusal loses the arg"  "$H" '"the bring-up ladder never ran this boot (navi48-stage too low, or the PSP chain "' '"the bring-up ladder never ran this boot (the chain "'
+run_plant "why: accessor disagrees with Call"  "$H" 'case AccelFireAtBoot::Call:             return "allowed";' 'case AccelFireAtBoot::Call:             return "ok";'
+run_plant "why: reasonOut gets the wrong text"  "$H" 'if (reasonOut) *reasonOut = r;' 'if (reasonOut) *reasonOut = "refused";'
+run_plant "facts: default gate mode becomes 0" "$H" 'uint32_t gateMode        = 1;' 'uint32_t gateMode        = 0;'
+# No "swap <cstdint> for an IOKit header" plant: that would stop the copy compiling, which the
+# harness reports as a build failure rather than a caught break. Section E's dependency pin is
+# already executed by the control run - the copy builds and runs on a machine with no IOKit.
+
+echo "== plants: the kext is actually wired to the gate =="
+run_plant "xsrc: header not included"          "$C" '#include "accel_fire_at_boot.h"' '#include "accel_fire_at_boot_off.h"'
+run_plant "xsrc: boot-arg renamed"             "$C" '"navi48-accel-fire-at-boot"' '"navi48-accel-fire-at-biot"'
+run_plant "xsrc: gate never consulted"         "$C" 'n48::accel_fire_at_boot_gate(ff, &fwhy)' 'n48::accel_fire_at_boot_gone(ff, &fwhy)'
+run_plant "xsrc: verdict not published"        "$C" 'setProperty("Navi48,AccelFireAtBoot", fwhy);' 'setProperty("Navi48,AccelFireAtBootX", fwhy);'
+run_plant "xsrc: fire return not published"    "$C" 'setProperty("Navi48,AccelFireAtBootKr"' 'setProperty("Navi48,AccelFireKr"'
+run_plant "xsrc: wrong accel action sent"      "$C" 'accelExperiment(1 /*fire*/' 'accelExperiment(0 /*fire*/'
+run_plant "xsrc: publish guard dropped"        "$C" 'if (ff.argRequested) setProperty("Navi48,AccelFireAtBoot", fwhy);' 'setProperty("Navi48,AccelFireAtBoot", fwhy);'
+run_plant "xsrc: facts read PM4Test, not 17"   "$C" 'gBringup.reached >= amdgpu::BringupStage::ComputeDispatch;' 'gBringup.reached >= amdgpu::BringupStage::PM4Test;' 1
+run_plant "xsrc: ladderRan hardcoded true"     "$C" 'ff.ladderRan       = gBringup.reached != amdgpu::BringupStage::None;' 'ff.ladderRan       = true;'
+run_plant "xsrc: selfTest stops reading ladder" "$C" 'ff.selfTestPassed  = gBringup.computePassed &&' 'ff.selfTestPassed  = true &&'
+run_plant "xsrc: the half-state claim edited"  "$C" 'The TTL hook stays installed' 'The TTL hook is rolled back'
+
+echo "== summary =="
+# Counts are plain integers: `${#ARR[@]}` on an empty array is an unbound-variable fatal
+# under `set -u` in bash 3.2, which would kill the run right where the tally prints.
+echo "caught:   $PASSN"
+echo "escaped:  $FAILN  ${FAIL[*]:-}"
+echo "plant-errors: $MISSN  ${MISS[*]:-}"
+
+AFTER=$(find "$SCR/src" -type f \( -name '*.h' -o -name '*.hpp' -o -name '*.cpp' \) \
+    | sort | xargs cat | cksum | awk '{print $1}')
+if [ "$AFTER" != "$PRISTINE" ]; then
+	echo "PRISTINE CHECKSUM CHANGED - the copy is polluted; investigate before trusting any result"
+	exit 3
+fi
+echo "pristine tree unchanged after the run (checksum $PRISTINE)"
+
+[ "$FAILN" -eq 0 ] && [ "$MISSN" -eq 0 ]
diff --git a/src/navi48-bringup/tests/accel_fire_at_boot_test.cpp b/src/navi48-bringup/tests/accel_fire_at_boot_test.cpp
new file mode 100644
index 0000000..236dc57
--- /dev/null
+++ b/src/navi48-bringup/tests/accel_fire_at_boot_test.cpp
@@ -0,0 +1,297 @@
+//
+//  accel_fire_at_boot_test.cpp — host suite for the boot-arg fire path (patch 0017).
+//
+//  Build (from src/navi48-bringup, on any machine — no Mac, no GPU):
+//    zig c++ -std=c++17 -Wall -Wextra -O1 -I tests/dalshim -I src \
+//        tests/accel_fire_at_boot_test.cpp -o /tmp/accel_fire_at_boot_test.exe
+//    /tmp/accel_fire_at_boot_test.exe .
+//
+//  The argv[1] directory is the navi48-bringup root, used by the source-pin sections.
+//
+//  Why a suite for six facts: this gate decides whether a boot publishes the one property
+//  that hands the card to every Metal client on the machine, and it does so with nobody at a
+//  keyboard to answer the verb. A wrong "yes" can panic the boot; a wrong "no" leaves the
+//  card armed forever and reads as "the port does not accelerate". Section D pins the reason
+//  a refusal is the safer default: the fire path installs the TTL hook BEFORE its exposure
+//  gate can withhold LoadAccelerator, so calling it on an unproven card produces the one
+//  state worse than not firing.
+//
+
+#include "accel_fire_at_boot.h"
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+static int gChecks = 0, gFailures = 0;
+static void report(const char *file, int line, const char *what, bool ok) {
+	gChecks++;
+	if (ok) return;
+	gFailures++;
+	printf("FAIL %s:%d: %s\n", file, line, what);
+}
+#define CHECK(cond) report(__FILE__, __LINE__, #cond, (cond))
+#define CHECK_MSG(cond, msg) report(__FILE__, __LINE__, msg, (cond))
+
+using n48::AccelFireAtBoot;
+using n48::AccelFireAtBootFacts;
+
+namespace {
+
+std::string slurp(const std::string &path) {
+	std::ifstream in(path, std::ios::binary);
+	if (!in) return "";
+	std::ostringstream ss;
+	ss << in.rdbuf();
+	std::string s = ss.str();
+	for (auto &c : s) if (c == '\r') c = '\n';       // CRLF-tolerant pins
+	while (!s.empty() && s.back() == '\n') s.pop_back();
+	return s;
+}
+
+size_t first_at(const std::string &hay, const std::string &needle, size_t from = 0) {
+	const size_t p = hay.find(needle, from);
+	return p == std::string::npos ? (size_t)-1 : p;
+}
+
+bool has(const std::string &hay, const std::string &needle) {
+	return hay.find(needle) != std::string::npos;
+}
+
+// The rules in prose, applied by hand to each combination — deliberately not a copy of the
+// header's expression order, so a refactor that changes precedence changes an expectation here.
+AccelFireAtBoot expect_verdict(const AccelFireAtBootFacts &f) {
+	if (!f.argRequested)    return AccelFireAtBoot::SkipNotRequested;
+	if (!f.experimentArmed) return AccelFireAtBoot::SkipNotArmed;
+	if (!f.ladderRan)       return AccelFireAtBoot::Refuse;
+	if (!f.selfTestPassed)  return AccelFireAtBoot::Refuse;
+	if (f.gateMode == 0)    return AccelFireAtBoot::Refuse;
+	return AccelFireAtBoot::Call;
+}
+
+AccelFireAtBootFacts allOn() {
+	AccelFireAtBootFacts f;
+	f.argRequested = f.experimentArmed = f.ladderRan = f.selfTestPassed = true;
+	f.gateMode = 1;
+	return f;
+}
+
+//----------------------------------------------------------------
+// A. the truth table, every combination
+//----------------------------------------------------------------
+void sectionA() {
+	printf("== A: truth table (48 combinations)\n");
+	int combos = 0, calls = 0, refusals = 0, skips = 0;
+	for (int arg = 0; arg < 2; arg++)
+	for (int armed = 0; armed < 2; armed++)
+	for (int ladder = 0; ladder < 2; ladder++)
+	for (int self = 0; self < 2; self++)
+	for (uint32_t gate = 0; gate <= 2; gate++) {
+		AccelFireAtBootFacts f;
+		f.argRequested    = arg != 0;
+		f.experimentArmed = armed != 0;
+		f.ladderRan       = ladder != 0;
+		f.selfTestPassed  = self != 0;
+		f.gateMode        = gate;
+
+		const char *why = nullptr;
+		const AccelFireAtBoot got = n48::accel_fire_at_boot_gate(f, &why);
+		const AccelFireAtBoot want = expect_verdict(f);
+		combos++;
+		if (got == AccelFireAtBoot::Call) calls++;
+		else if (got == AccelFireAtBoot::Refuse) refusals++;
+		else skips++;
+		CHECK_MSG(got == want,
+		          ("combo arg=" + std::to_string(arg) + " armed=" + std::to_string(armed) +
+		           " ladder=" + std::to_string(ladder) + " self=" + std::to_string(self) +
+		           " gate=" + std::to_string(gate) + " -> verdict").c_str());
+		CHECK_MSG(why != nullptr && *why != '\0', "every verdict carries a reason");
+	}
+	CHECK_MSG(combos == 48, "the table covers 2*2*2*2*3 combinations");
+	// arg off = 24 skips; arg on/armed off = 12 more; of the remaining 12 the ladder-or-self-test
+	// is off in 9 and gate 0 takes one more.
+	CHECK_MSG(calls == 2, "exactly two combinations arm the fire (self-test passed, gate 1 or 2)");
+	CHECK_MSG(refusals == 10, "ten combinations refuse");
+	CHECK_MSG(skips == 36, "thirty-six combinations leave the boot as it was");
+	printf("   call %d / refuse %d / skip %d\n", calls, refusals, skips);
+}
+
+//----------------------------------------------------------------
+// B. what the reasons must name
+//----------------------------------------------------------------
+void sectionB() {
+	printf("== B: reason text names the mechanism\n");
+
+	AccelFireAtBootFacts f = allOn();
+	const char *why = nullptr;
+	CHECK(n48::accel_fire_at_boot_gate(f, &why) == AccelFireAtBoot::Call);
+	CHECK_MSG(std::strcmp(why, "allowed") == 0, "an allowed boot says exactly 'allowed'");
+
+	// gate 0 and gate 2 both reach the same Call path only for gate != 0.
+	f.gateMode = 2;
+	CHECK(n48::accel_fire_at_boot_gate(f, &why) == AccelFireAtBoot::Call);
+	f.gateMode = 0;
+	CHECK(n48::accel_fire_at_boot_gate(f, &why) == AccelFireAtBoot::Refuse);
+	CHECK_MSG(has(why, "navi48-accel-gate=0"), "a gate-0 refusal names the boot-arg that caused it");
+
+	// The half-state refusal is the one an owner has to act on: it has to say what to run instead.
+	f = allOn();
+	f.gateMode = 1;
+	f.selfTestPassed = false;
+	CHECK(n48::accel_fire_at_boot_gate(f, &why) == AccelFireAtBoot::Refuse);
+	CHECK_MSG(has(why, "stage-17"), "the refusal says which rung did not pass");
+	CHECK_MSG(has(why, "TTL"), "the refusal says why calling anyway is not harmless");
+	CHECK_MSG(has(why, "LoadAccelerator"), "the refusal names the property at stake");
+	CHECK_MSG(has(why, "navi48test accel fire"), "the refusal names the diagnostic route it is not taking");
+
+	f.selfTestPassed = true;
+	f.ladderRan = false;
+	CHECK(n48::accel_fire_at_boot_gate(f, &why) == AccelFireAtBoot::Refuse);
+	CHECK_MSG(has(why, "navi48-stage"), "a no-ladder refusal says which arg to raise");
+
+	f.ladderRan = true;
+	f.experimentArmed = false;
+	CHECK(n48::accel_fire_at_boot_gate(f, &why) == AccelFireAtBoot::SkipNotArmed);
+	CHECK_MSG(has(why, "navi48-accel-experiment"),
+	          "an un-armed skip says which arg is missing, not that this boot failed");
+
+	f.argRequested = false;
+	CHECK(n48::accel_fire_at_boot_gate(f, &why) == AccelFireAtBoot::SkipNotRequested);
+	CHECK_MSG(has(why, "navi48-accel-fire-at-boot"), "the default skip names the arg it did not see");
+
+	// The header owns the text, so the enum's own accessor cannot disagree with a verdict.
+	CHECK_MSG(std::strcmp(n48::accelFireAtBootReason(AccelFireAtBoot::Call), "allowed") == 0,
+	          "reason accessor agrees with the Call verdict text");
+	CHECK_MSG(std::strcmp(n48::accelFireAtBootReason(AccelFireAtBoot::Refuse), "refused") == 0,
+	          "Refuse has no single fixed text - it is per-branch");
+	CHECK(has(n48::accelFireAtBootReason(AccelFireAtBoot::SkipNotArmed), "TTL hook"));
+
+	// The header's default gate mode must equal the mode the kext parses when the arg is absent,
+	// or a struct built without setting it decides differently from the boot it stands for.
+	{
+		AccelFireAtBootFacts d;
+		d.argRequested = d.experimentArmed = d.ladderRan = d.selfTestPassed = true;
+		CHECK_MSG(n48::accel_fire_at_boot_gate(d, &why) == AccelFireAtBoot::Call,
+		          "default gateMode behaves as self-test (1), the kext's own default");
+	}
+
+	// reasonOut may be null (a caller that only wants the verdict) without breaking anything.
+	CHECK(n48::accel_fire_at_boot_gate(allOn(), nullptr) == AccelFireAtBoot::Call);
+	AccelFireAtBootFacts bad = allOn();
+	bad.selfTestPassed = false;
+	CHECK(n48::accel_fire_at_boot_gate(bad, nullptr) == AccelFireAtBoot::Refuse);
+}
+
+//----------------------------------------------------------------
+// C. the kext really consults the gate
+//----------------------------------------------------------------
+void sectionC(const std::string &root) {
+	printf("== C: Navi48Bringup.cpp consults the gate\n");
+	const std::string s = slurp(root + "/src/Navi48Bringup.cpp");
+	CHECK_MSG(!s.empty(), "Navi48Bringup.cpp readable");
+	if (s.empty()) return;
+
+	CHECK_MSG(has(s, "#include \"accel_fire_at_boot.h\""), "the header is included");
+	CHECK_MSG(has(s, "\"navi48-accel-fire-at-boot\""), "the boot-arg is parsed by that exact name");
+	CHECK_MSG(has(s, "n48::accel_fire_at_boot_gate"), "the gate is consulted");
+	CHECK_MSG(has(s, "n48::AccelFireAtBootFacts"), "the facts struct is used");
+	CHECK_MSG(has(s, "\"Navi48,AccelFireAtBoot\""), "the verdict reason is published");
+	CHECK_MSG(has(s, "\"Navi48,AccelFireAtBootKr\""), "the fire path's return is published too");
+	CHECK_MSG(has(s, "accelExperiment(1 /*fire*/"), "action 1 is what the verb would have sent");
+	CHECK_MSG(first_at(s, "\"navi48-accel-fire-at-boot\"") ==
+	          first_at(s, "\"navi48-accel-fire-at-boot\"", 0), "the arg is parsed once");
+
+	// The facts must be the same expressions the exposure gate uses, or the two can disagree
+	// about whether the self-test passed - and only this one gets to decide at boot.
+	auto count_of = [](const std::string &hay, const std::string &needle) {
+		size_t n = 0, p = 0;
+		while ((p = hay.find(needle, p)) != std::string::npos) { n++; p += needle.size(); }
+		return n;
+	};
+	CHECK_MSG(has(s, "ff.selfTestPassed") &&
+	          has(s, "ff.selfTestPassed  = gBringup.computePassed &&"),
+	          "selfTestPassed comes from the ladder's own computePassed flag, not a constant");
+	CHECK_MSG(has(s, "ff.ladderRan") && has(s, "amdgpu::BringupStage::None"),
+	          "ladderRan is derived from the ladder's own progress");
+	CHECK_MSG(count_of(s, ">= amdgpu::BringupStage::ComputeDispatch;") >= 2,
+	          "the auto-fire and the inner exposure gate require the same rung (two call sites)");
+
+	// A boot without the arg must not gain a property, or the untouched path stops being untouched.
+	const size_t guard = first_at(s, "if (ff.argRequested) setProperty(\"Navi48,AccelFireAtBoot\", fwhy);");
+	CHECK_MSG(guard != (size_t)-1, "the property is only published when the arg was seen");
+	CHECK_MSG(first_at(s, "if (fv == n48::AccelFireAtBoot::Call)") > guard,
+	          "the call happens after that guard, not before it");
+}
+
+//----------------------------------------------------------------
+// D. the ordering that makes a refusal the safe default
+//----------------------------------------------------------------
+void sectionD(const std::string &root) {
+	printf("== D: the fire path hooks TTL before it can withhold the property\n");
+	const std::string s = slurp(root + "/src/Navi48Bringup.cpp");
+	if (s.empty()) { CHECK_MSG(false, "Navi48Bringup.cpp readable"); return; }
+
+	const size_t hook   = first_at(s, "install_ttl_hook(pciDevice, &gNavi48Ttl)");
+	const size_t gate0  = first_at(s, "if (gate == 0) {");
+	const size_t withheld = first_at(s, "self-test did not pass, so LoadAccelerator is");
+	const size_t publish = first_at(s, "pciDevice->setProperty(\"LoadAccelerator\", kOSBooleanTrue);");
+
+	CHECK_MSG(hook != (size_t)-1, "the fire path installs the TTL hook");
+	CHECK_MSG(publish != (size_t)-1, "the fire path publishes LoadAccelerator");
+	CHECK_MSG(hook < gate0, "the hook is installed BEFORE the gate-0 refusal (the half-state is real)");
+	CHECK_MSG(hook < withheld, "the hook is installed BEFORE the self-test refusal");
+	CHECK_MSG(hook < publish, "and before the publish, as it must be for the verb path");
+
+	// The comment this suite was written against has to stay true, or the refusal here is
+	// defending a state that no longer exists and the argument for it is stale.
+	CHECK_MSG(has(s, "The TTL hook stays installed"),
+	          "gate 0 documents that it leaves the hook installed");
+}
+
+//----------------------------------------------------------------
+// E. the header is self-contained and dependency-free
+//----------------------------------------------------------------
+void sectionE(const std::string &root) {
+	printf("== E: header shape\n");
+	const std::string h = slurp(root + "/src/accel_fire_at_boot.h");
+	CHECK_MSG(!h.empty(), "the header is readable");
+	CHECK_MSG(has(h, "#include <cstdint>"), "it needs only <cstdint>");
+	// The prose is allowed to name IOService/IORegistry — the point is that the code does not use
+	// them, so strip comment lines before looking.
+	std::string code;
+	{
+		std::istringstream in(h);
+		std::string line;
+		while (std::getline(in, line)) {
+			if (line.find("//") == 0) continue;
+			if (line.empty() && code.empty()) continue;
+			if (!line.empty() && line[0] == '/' && line.size() > 1 && line[1] == '*') continue;
+			code += line;
+			code += '\n';
+		}
+	}
+	CHECK_MSG(!has(code, "#include <IOKit"), "no IOKit include");
+	CHECK_MSG(!has(code, "IOService") && !has(code, "IORegistry"), "no IOKit types in the code");
+	CHECK_MSG(!has(code, "PE_parse_boot_argn"), "it does not read boot-args itself");
+	CHECK_MSG(!has(code, "setProperty"), "it does not publish anything itself");
+	CHECK_MSG(has(h, "namespace n48"), "it lives in n48 like the arm gate");
+	// Every refusal branch must be reachable in prose too: a branch with no text would print "".
+	CHECK_MSG(has(h, "\"the bring-up ladder never ran this boot") &&
+	          has(h, "\"the stage-17 compute dispatch did not pass") &&
+	          has(h, "\"navi48-accel-gate=0 forbids"), "all three refusals carry their own text");
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+	const std::string root = (argc > 1) ? argv[1] : ".";
+	sectionA();
+	sectionB();
+	sectionC(root);
+	sectionD(root);
+	sectionE(root);
+	printf("\n%d checks, %d failures\n", gChecks, gFailures);
+	return gFailures ? 1 : 0;
+}
