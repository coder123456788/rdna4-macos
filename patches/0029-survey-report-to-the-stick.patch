+// 0029: the survey report travels the same road as the verdict report: the fixed 1536-byte
+// record, /Volumes/OPENCORE/NAVI48.TXT first, the file's own data cluster through the block
+// device second. There is no verdict to wait for - the survey was complete when start() called
+// this - so it starts at once and retries only while neither channel works.
+volatile uint32_t gSurveyStarted;
+volatile uintptr_t gSurveyClient;
+char gSurveyText[n48::kSurveyReportCap];
+
+void survey_report_thread(void *, wait_result_t) {
+    IOService *client = (IOService *)__atomic_load_n(&gSurveyClient, __ATOMIC_ACQUIRE);
+    bool saidGrace = false;
+    for (uint32_t t = 0; t < n48::kReportFileRetrySeconds; t++) {
+        const int vfsErr = write_report_file(gSurveyText, sizeof gSurveyText);
+        int err = vfsErr;
+        const char *channel = "the mounted volume";
+        if (err != 0 && t >= kSurveyVfsGraceSeconds) {
+            err = n48::report_raw_write(client, gSurveyText, sizeof gSurveyText);
+            channel = "the block device (stick not mounted)";
+        }
+        if (err == 0) {
+            TAKELOG("survey report written to %s through %s (%llu bytes) - no photograph needed",
+                    n48::kReportFilePath, channel, (unsigned long long)sizeof gSurveyText);
+            return;
+        }
+        if (t == 0)
+            TAKELOG("survey report not writable yet: volume %d; retrying, block device after %u s",
+                    vfsErr, kSurveyVfsGraceSeconds);
+        if (t == kSurveyVfsGraceSeconds && !saidGrace) {
+            TAKELOG("survey report: volume still absent after %u s - trying the block device",
+                    kSurveyVfsGraceSeconds);
+            saidGrace = true;
+        }
+        IOSleep(1000);
+    }
+    TAKELOG("survey report never written: %s never became writable", n48::kReportFilePath);
+}
