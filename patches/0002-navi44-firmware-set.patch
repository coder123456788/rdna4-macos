+// Called once from probe(), before any stage runs. Idempotent: a repeat call
+// with the same device leaves a built table untouched.
+//
+// Clearing the rows here (rather than relying on build_table() to overwrite
+// them) keeps fw_get() honest if the caller looks at an id between selection
+// and first use: every row is either the selected die's blob or an explicit
+// {nullptr, 0, name} — never the other die's data.
+void fw_select_for_device(uint16_t deviceId) {
+    const uint32_t want = (deviceId == 0x7590) ? kSetNavi44 : kSetNavi48;
+    if (g_set == want) return;
+
+    g_set = want;
+    g_built = false;
+    for (uint32_t i = 0; i < kCount; ++i) {
+        g_table[i] = FwBlob{ nullptr, 0, nullptr, static_cast<FwId>(i) };
+    }
+}
+
+bool fw_is_navi44() {
+    return g_set == kSetNavi44;
+}
