+// 0030: the progress record written before the full report exists. Pure, same writer idiom as
+// survey_report_text. It starts with "navi" so the raw writer's magic check (accel_report_raw.h)
+// accepts a stage write and still accepts the report that replaces it later in the same boot.
+inline size_t survey_stage_text(char *out, size_t cap, uint32_t reached) {
+    struct W {
+        char *out;
+        size_t cap, len;
+        void ch(char c) { if (out && len + 1 < cap) out[len] = c; len++; }
+        void str(const char *s) { while (s && *s) ch(*s++); }
+        void dec(uint32_t v) { ch((char)('0' + (v % 10))); }
+        void finish() { if (out && cap) out[len < cap ? len : cap - 1] = 0; }
+    } w = { out, cap, 0 };
+
+    w.str("navi48 survey progress: start=");
+    w.dec(reached & kSurveyStageStart ? 1u : 0u);
+    w.str(" mmio=");
+    w.dec(reached & kSurveyStageMmio ? 1u : 0u);
+    w.str(" discovery=");
+    w.dec(reached & kSurveyStageDiscovery ? 1u : 0u);
+    w.str(" report=");
+    w.dec(reached & kSurveyStageReport ? 1u : 0u);
+    w.str("; patch 0030 - the full record replaces this line when the survey completes\n");
+    w.finish();
+    return w.len;
+}
