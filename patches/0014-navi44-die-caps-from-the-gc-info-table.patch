diff --git a/src/navi48-bringup/src/Navi48Bringup.cpp b/src/navi48-bringup/src/Navi48Bringup.cpp
index 7548056..2ebb929 100644
--- a/src/navi48-bringup/src/Navi48Bringup.cpp
+++ b/src/navi48-bringup/src/Navi48Bringup.cpp
@@ -869,6 +869,19 @@ bool Navi48Bringup::buildDeviceContext() {
 	if (fbBase == 0xFFFFFFFF) { N48LOG("dev: cannot read FB_LOCATION_BASE"); return false; }
 	dev.vramMcBase = static_cast<uint64_t>(fbBase & n48::kFbLocationMask) << 24;
 	if (!amdgpu::fill_ip_base_table(ipDiscovery, dev.ip)) { N48LOG("dev: IP base table incomplete"); return false; }
+	// 0014 — the GC info table sits beside the IP list in the same binary, and it is
+	// where Linux gets the die caps (amdgpu_discovery.c:2173-2181) before it reads a
+	// single register. Its gc_num_tccs is the ONLY TCC source on RDNA4:
+	// gfx_v12_0.c:1831 gfx_v12_0_get_tcc_info() is an empty stub and
+	// gc_12_0_0_sh_mask.h has no TCC field at all. Absent or unreadable is not an
+	// error here — the caps stay at gfx_default_caps()'s per-IP-version numbers.
+	if (ipDiscovery.gcInfo(dev.gcTab))
+		N48LOG("dev: GC info v%u.%u — se=%u sh_per_se=%u cu_per_sh=%u rb_per_se=%u tcc=%u",
+		       dev.gcTab.verMajor, dev.gcTab.verMinor, dev.gcTab.numSe, dev.gcTab.numShPerSe,
+		       dev.gcTab.numCuPerSh, dev.gcTab.numRbPerSe, dev.gcTab.numTccs);
+	else
+		N48LOG("dev: no GC info table (absent, or refused its id/size/checksum) — "
+		       "die caps stay at the per-IP-version defaults, TCC unreported");
 	N48LOG("dev: context ready — MC base 0x%llx, region vram+[0x%llx, 0x%llx), GC base 0x%x MP0 base 0x%x MMHUB base 0x%x",
 	       dev.vramMcBase, dev.vramBase, dev.vramLimit, dev.ip.get(amdgpu::IPBlock::GC),
 	       dev.ip.get(amdgpu::IPBlock::MP0), dev.ip.get(amdgpu::IPBlock::MMHUB));
