diff --git a/src/navi48-bringup/src/ipdiscovery.cpp b/src/navi48-bringup/src/ipdiscovery.cpp
index ee25b55..74a7146 100644
--- a/src/navi48-bringup/src/ipdiscovery.cpp
+++ b/src/navi48-bringup/src/ipdiscovery.cpp
@@ -151,3 +151,67 @@ bool IpDiscovery::regByteOffset(uint16_t hwId, uint8_t instance, uint8_t segment
 	byteOffset = (ip.bases[segment] + regDwordOffset) * 4;
 	return true;
 }
+
+// ---- the GC info table ----------------------------------------------------
+// GPU-info tables live beside the IP list, in the same binary: the header's
+// table_list is an array of {u16 offset, u16 checksum, u16 size, u16 pad} and
+// GC is index 1 (discovery.h:42-50 `IP_DISCOVERY = 0, GC, ...`), the offset
+// being relative to the binary start — exactly Linux's
+// amdgpu_discovery_get_table_info_from_bin() plus the GC arm of
+// amdgpu_discovery_table_check() (amdgpu_discovery.c:664-672) and its
+// bytesum rule (:481-507, sum over the table's declared size from its first
+// byte, compared with table_list[GC].checksum).
+//
+// gc_info_v2_0 (discovery.h:411) is header{table_id u32, major u16, minor u16,
+// size u32} then num_se +16, num_cu_per_sh +20, num_sh_per_se +24,
+// num_rb_per_se +28, num_tccs +32 — the same five words Linux reads at
+// amdgpu_discovery.c:2173-2181, and v2_1 only appends.
+static constexpr uint32_t kGcTableId = 0x4347;   // GC_TABLE_ID, discovery.h:30
+static constexpr uint16_t kGcTableIndex = 1;     // enum table: IP_DISCOVERY = 0, GC
+static constexpr size_t kTableInfoStride = 8;
+static constexpr uint32_t kGcCapsEnd = 36;       // one past gc_num_tccs
+
+bool IpDiscovery::gcInfo(IpGcInfo &out) const {
+	out = IpGcInfo{};
+	if (!valid)
+		return false;
+
+	uint16_t vmajor, entryOff, entrySum;
+	if (!readU16(binBase + 4, vmajor))
+		return false;
+	const size_t list = binBase + (vmajor >= 2 ? 16 : 12) + kGcTableIndex * kTableInfoStride;
+	if (!readU16(list, entryOff) || !readU16(list + 2, entrySum) || entryOff == 0)
+		return false;   // the die filed no GC table: nothing to read, and no guessing
+
+	const size_t t = binBase + entryOff;
+	uint32_t tableId, tableSize;
+	uint16_t major, minor;
+	if (!readU32(t, tableId) || tableId != kGcTableId)
+		return false;
+	if (!readU16(t + 4, major) || !readU16(t + 6, minor) || !readU32(t + 8, tableSize))
+		return false;
+	// A v1 GC table (RDNA1/2/3) puts num_wgp0_per_sa where v2 puts
+	// num_cu_per_sh, so reading it as v2 would report a CU count that is
+	// really half a WGP count. This card is 12.0.x, which is v2; anything
+	// else is refused rather than reinterpreted.
+	if (major != 2 || minor > 1 || tableSize < kGcCapsEnd || tableSize > 4096)
+		return false;
+	if (t + tableSize > size)
+		return false;
+
+	uint16_t sum = 0;
+	for (uint32_t i = 0; i < tableSize; i++)
+		sum = static_cast<uint16_t>(sum + data[t + i]);
+	if (sum != entrySum)
+		return false;   // a corrupt table is worse than no table: it would arm the caps wrongly
+
+	if (!readU32(t + 16, out.numSe) || !readU32(t + 20, out.numCuPerSh) ||
+	    !readU32(t + 24, out.numShPerSe) || !readU32(t + 28, out.numRbPerSe) ||
+	    !readU32(t + 32, out.numTccs))
+		return false;
+
+	out.valid = 1;
+	out.verMajor = major;
+	out.verMinor = minor;
+	return true;
+}
