diff --git a/src/navi48-bringup/src/accel_report_file.h b/src/navi48-bringup/src/accel_report_file.h
new file mode 100644
index 0000000..2b1d5dc
--- /dev/null
+++ b/src/navi48-bringup/src/accel_report_file.h
@@ -0,0 +1,128 @@
+//  accel_report_file.h — patch 0027: the verdict leaves the screen and lands on the stick.
+//
+//  0019-0025 answer the two questions a boot has to answer - did this port publish
+//  LoadAccelerator, and did Apple's accelerator then take the card - but every answer is printed
+//  to the -v console and needs a photograph to come back. This machine has no camera in the loop,
+//  so the answer has to survive the boot by itself.
+//
+//  The boot stick is a plain FAT32 data partition (not an ESP), so macOS auto-mounts it as
+//  /Volumes/OPENCORE at every boot with the stick attached. accel_report_file.cpp writes this
+//  text there from a kernel thread after the verdict is settled; the owner only has to hand the
+//  stick back, and the file is readable from Windows as E:\navi48-report.txt.
+//
+//  The text is built here, with no IOKit, so the host suite can check every line and every
+//  variant without a Mac - the same split as accel_takeover_report.h / accel_takeover.cpp.
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "accel_takeover_report.h"
+
+namespace n48 {
+
+constexpr const char *kReportFilePath = "/Volumes/OPENCORE/navi48-report.txt";
+constexpr uint32_t kReportFileRetrySeconds = 120;  // the FAT volume mounts when diskarbitrationd gets there
+constexpr uint32_t kReportFileSettleSeconds = 2;   // let Apple's last calls land in the census
+
+struct ReportFileInputs {
+    const char *fireHeadline;  // 0019: what this port decided (never null when written)
+    bool armed;                // a watcher was watching this boot
+    bool started;              // Apple's accelerator announced itself
+    bool appleKextLoaded;      // TakeoverFacts, gathered after the wait
+    bool accelAttached;
+    uint16_t deviceId;         // IOKit properties, 0 = none injected
+    uint16_t vendorId;
+    uint32_t waited;           // seconds the writer waited before settling
+    uint32_t ttlBound;
+    uint32_t ttlCalls;
+    uint32_t ttlSlots;
+    int firstUnsupported;
+    uint64_t reachedMask;      // bit s = slot s was called
+};
+
+// Pure; snprintf semantics: returns the length the full text needs, always NUL-terminates when
+// cap > 0, and counts without writing when out is null. One line per fact so a partial file
+// still reads.
+inline size_t report_file_text(char *out, size_t cap, const ReportFileInputs &in) {
+    struct W {
+        char *out;
+        size_t cap, len;
+        void ch(char c) { if (out && len + 1 < cap) out[len] = c; len++; }
+        void str(const char *s) { while (s && *s) ch(*s++); }
+        void dec(uint32_t v) {
+            char b[10];
+            int i = 0;
+            if (!v) { ch('0'); return; }
+            while (v) { b[i++] = (char)('0' + v % 10); v /= 10; }
+            while (i) ch(b[--i]);
+        }
+        void hex4(uint16_t v) {
+            static const char h[] = "0123456789abcdef";
+            for (int s = 12; s >= 0; s -= 4) ch(h[(v >> s) & 15]);
+        }
+        void finish() { if (out && cap) out[len < cap ? len : cap - 1] = 0; }
+    } w = { out, cap, 0 };
+
+    w.str("navi48 report - written by the kext; no photograph needed\n");
+    w.str("acceleration report: ");
+    w.str(in.fireHeadline ? in.fireHeadline : "(not reported)");
+    w.ch('\n');
+    w.str("takeover: ");
+    w.str(in.started ? "STARTED - Apple's accelerator announced itself"
+          : in.armed  ? "NO TAKEOVER - no announce within the wait"
+                      : "not tracked - no watcher was armed on this boot");
+    w.ch('\n');
+    if (!in.started) {
+        const TakeoverFacts f = { in.appleKextLoaded, in.accelAttached };
+        w.str("cause: ");
+        w.str(accel_takeover_diagnosis(f));
+        w.ch('\n');
+    }
+    w.str("waited: ");
+    w.dec(in.waited);
+    w.str(" s\n");
+    w.str("kext loaded=");
+    w.dec(in.appleKextLoaded ? 1u : 0u);
+    w.str("  accelerator child=");
+    w.dec(in.accelAttached ? 1u : 0u);
+    w.ch('\n');
+    w.str("card: device-id 0x");
+    w.hex4(in.deviceId);
+    w.str("  vendor-id 0x");
+    w.hex4(in.vendorId);
+    w.str("  (IOKit properties; 0 = none injected)\n");
+    w.str("ttl: bound=");
+    w.dec(in.ttlBound);
+    w.str(" calls=");
+    w.dec(in.ttlCalls);
+    w.str(" slots=");
+    w.dec(in.ttlSlots);
+    w.str("/43 first unsupported=");
+    if (in.firstUnsupported < 0) {
+        w.ch('-');
+        w.dec((uint32_t)(-in.firstUnsupported));
+    } else {
+        w.dec((uint32_t)in.firstUnsupported);
+    }
+    w.ch('\n');
+    if (in.reachedMask) {
+        w.str("ttl slots reached:");
+        static const char hx[] = "0123456789abcdef";
+        for (int s = 0; s < 43; s++) {
+            if ((in.reachedMask >> s) & 1) {
+                w.ch(' ');
+                w.ch(hx[s >> 4]);
+                w.ch(hx[s & 15]);
+            }
+        }
+        w.ch('\n');
+    }
+    w.finish();
+    return w.len;
+}
+
+// ---- runtime, defined in accel_takeover.cpp ----
+void takeover_start_writer(const char *fireHeadline);
+
+} // namespace n48
