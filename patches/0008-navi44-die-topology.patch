@@ -342,6 +342,51 @@ kern_return_t gfx_setup_rb(const DeviceContext &dev, GFXConfig &cfg);
 //
 kern_return_t gfx_get_cu_info(const DeviceContext &dev, GFXConfig &cfg);
 
+//
+// GFXTopo — the die geometry as user space needs to see it: the same
+// values Linux hands every DRM client through amdgpu_info_ioctl's
+// drm_amdgpu_info_device (amdgpu_kms.c:952-1030). A consumer with no
+// kernel ioctl (our native path) cannot derive these any other way, and
+// a hardcoded table is only right for the die it was written for — Navi
+// 48 alone. Everything below comes out of GFXConfig, which the bring-up
+// path filled from GB_ADDR_CONFIG and the harvest registers of the card
+// that is actually fitted.
+//
+// Field names and semantics mirror the ioctl so that the ABI mapping is
+// a copy, not a translation:
+//   num_shader_engines            <- max_shader_engines
+//   num_shader_arrays_per_engine  <- max_sh_per_se
+//   num_cu_per_sh                 <- max_cu_per_sh
+//   enabled_rb_pipes_mask         <- backend_enable_mask (HARVESTED)
+//   num_rb_pipes                  <- max_backends_per_se * max_shader_engines
+//                                    (PHYSICAL — upstream multiplies the caps,
+//                                    it does not popcount the mask; gfx1201 is
+//                                    16 here and 0xffff in the mask)
+//   cu_active_number              <- cu_info.number
+//   cu_bitmap[][]                 <- cu_info.bitmap[][], which gfx_get_cu_info
+//                                    already stores as [se % 4][sa + (se / 4) * 2]
+//                                    — the exact layout ac_fill_hw_info reads
+//                                    (ac_gpu_info.c:1247).
+//
+struct GFXTopo {
+    bool      valid;                 // false until gfx_constants_init filled the config
+    uint32_t  gc_major, gc_minor, gc_rev;
+    uint32_t  max_shader_engines, max_sh_per_se, max_cu_per_sh, max_backends_per_se;
+    uint32_t  num_rb_pipes;          // physical SE x RB/SE
+    uint32_t  enabled_rb_pipes_mask; // harvested, bits 0..31
+    uint32_t  enabled_rb_pipes_mask_hi;
+    uint32_t  cu_active_number, cu_active_wgp_number;
+    uint32_t  num_se;                // SEs that keep at least one CU
+    uint32_t  cu_bitmap[4][2];
+};
+
+//
+// Fill `out` from `cfg` + `gc`. Pure: no MMIO, no locking, safe from any
+// client context. Zeroes `out` first, so a caller may pass an
+// uninitialised struct.
+//
+void gfx_topo_report(const GFXConfig &cfg, const IPVersion &gc, GFXTopo &out);
+
