+//------------------------------------------------------------------
+// gfx_topo_report — the drm_amdgpu_info_device subset that describes
+// THIS card, read out of the config the harvest registers filled in.
+// Pure: no MMIO, no locking. The field-by-field rules (and the
+// upstream line numbers behind them) are on the struct in
+// amdgpu_gfx.h.
+//------------------------------------------------------------------
+void
+gfx_topo_report(const GFXConfig &cfg, const IPVersion &gc, GFXTopo &out)
+{
+    memset(&out, 0, sizeof(out));
+    out.gc_major = gc.major;
+    out.gc_minor = gc.minor;
+    out.gc_rev   = gc.rev;
+
+    // gfx_constants_init marks the config inited only once both harvest
+    // reads have run — and it keeps going when either one fails, so a
+    // config that is not inited yet has no geometry worth reporting. The
+    // consumer then has nothing to override its own table with, which is
+    // the honest answer rather than a zeroed one that looks like a die
+    // with no CUs.
+    if (!cfg.inited) return;
+    out.valid = true;
+
+    out.max_shader_engines  = cfg.max_shader_engines;
+    out.max_sh_per_se       = cfg.max_sh_per_se;
+    out.max_cu_per_sh       = cfg.max_cu_per_sh;
+    out.max_backends_per_se = cfg.max_backends_per_se;
+
+    // amdgpu_kms.c:970 — num_rb_pipes is the CAP product (SE x RB/SE), not
+    // the popcount of the harvest mask; :969 sends the mask itself. The
+    // two disagree on any harvested part, and RADV uses both.
+    out.num_rb_pipes          = cfg.max_backends_per_se * cfg.max_shader_engines;
+    out.enabled_rb_pipes_mask = cfg.active_rb_bitmap;
+    // The mask would only need the high word past 32 RBs; RDNA4 tops out at
+    // 8 SE x 8 RB/SE, and cfg.active_rb_bitmap is one uint32, so it is 0.
+    out.enabled_rb_pipes_mask_hi = 0;
+
+    out.cu_active_number     = cfg.num_active_cus;
+    out.cu_active_wgp_number = cfg.num_active_wgps;
+    memcpy(out.cu_bitmap, cfg.active_cu_bitmap, sizeof(out.cu_bitmap));
+
+    // ac_gpu_info.c:1269-1281 counts the live SEs itself the same way: an
+    // SE counts when any of its shader arrays kept a CU.
+    const uint32_t nse = cfg.max_shader_engines < 4 ? cfg.max_shader_engines : 4;
+    const uint32_t nsa = cfg.max_sh_per_se < 2 ? cfg.max_sh_per_se : 2;
+    for (uint32_t se = 0; se < nse; se++) {
+        for (uint32_t sa = 0; sa < nsa; sa++) {
+            if (out.cu_bitmap[se][sa] != 0) { out.num_se++; break; }
+        }
+    }
+}
