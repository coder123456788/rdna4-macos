diff --git a/src/navi48-bringup/src/amd/native_s1c.cpp b/src/navi48-bringup/src/amd/native_s1c.cpp
index bea98f0..7dbde60 100644
--- a/src/navi48-bringup/src/amd/native_s1c.cpp
+++ b/src/navi48-bringup/src/amd/native_s1c.cpp
@@ -1100,6 +1100,36 @@ IOReturn n1c_query_info(const N1cRef &ref, n48n_info *o) {
     return kIOReturnSuccess;
 }
 
+// ABI 1.13: QueryInfo with the die-topology tail (n48n_topo at byte 192 of the caller's buffer). The 192 B record is
+// written by n1c_query_info exactly as before, so every existing assertion about that function still holds; the tail is
+// filled from the config the harvest registers produced, and N48N_INFO_TOPO is claimed only when it really was.
+IOReturn n1c_query_info_ext(const N1cRef &ref, n48n_info *info, n48n_topo *topo) {
+    if (topo == nullptr) return kIOReturnBadArgument;
+    memset(topo, 0, sizeof(*topo));
+    IOReturn rc = n1c_query_info(ref, info);
+    if (rc != kIOReturnSuccess) return rc;
+
+    GFXTopo t;
+    gfx_topo_report(gCtx->gfx, gCtx->dev->ip.getVersion(IPBlock::GC), t);
+    if (!t.valid) return kIOReturnSuccess;   // bring-up has not filled the config yet: no tail, no flag
+
+    topo->gc_version               = ((uint32_t)t.gc_major << 16) | ((uint32_t)t.gc_minor << 8) | t.gc_rev;
+    topo->max_shader_engines       = t.max_shader_engines;
+    topo->max_sh_per_se            = t.max_sh_per_se;
+    topo->max_cu_per_sh            = t.max_cu_per_sh;
+    topo->max_backends_per_se      = t.max_backends_per_se;
+    topo->num_rb_pipes             = t.num_rb_pipes;
+    topo->enabled_rb_pipes_mask    = t.enabled_rb_pipes_mask;
+    topo->enabled_rb_pipes_mask_hi = t.enabled_rb_pipes_mask_hi;
+    topo->cu_active_number         = t.cu_active_number;
+    topo->cu_active_wgp_number     = t.cu_active_wgp_number;
+    topo->num_se                   = t.num_se;
+    memcpy(topo->cu_bitmap, t.cu_bitmap, sizeof(topo->cu_bitmap));
+    topo->size = (uint32_t)sizeof(*topo);
+    info->flags |= N48N_INFO_TOPO;
+    return kIOReturnSuccess;
+}
