+// ---------------------------------------------------------------------------
+// surveyGeometry — the two numbers a Navi 44 survey exists to produce, both
+// through the bring-up's own code rather than a second decoder:
+//
+//   GB_ADDR_CONFIG   decoded by gfx_get_gb_addr_config (amd/gfx_v12_0.cpp), the
+//                    function whose SE count sizes gfx_setup_rb's harvest
+//                    masks. Navigation here also exercises patch 0003's
+//                    per-version caps: gfx_gpu_early_init seeds 2 SE / 2 RB on
+//                    GC 12.0.0, the register then overrides them.
+//   FB_LOCATION      the MMHUB window buildDeviceContext turns into vramMcBase.
+//                    VRAM byte 0 has to sit at BASE << 24 for every stage above
+//                    the PSP chain to address memory correctly.
+//
+// Reads one GC register and two MMHUB registers. Nothing is written.
+// ---------------------------------------------------------------------------
+void Navi48Bringup::surveyGeometry() {
+	amdgpu::DeviceContext probe {};
+	probe.rmmio = rmmio;
+	probe.rmmioSize = rmmioSize;
+	if (!amdgpu::fill_ip_base_table(ipDiscovery, probe.ip)) {
+		N48LOG("geometry: IP base table incomplete — GB_ADDR_CONFIG not decoded");
+	} else {
+		amdgpu::GFXConfig cfg {};
+		if (amdgpu::gfx_gpu_early_init(probe, cfg) != kIOReturnSuccess) {
+			N48LOG("geometry: gpu_early_init refused — no caps to compare against");
+		} else {
+			const uint32_t expSE = cfg.max_shader_engines;
+			const uint32_t expRB = cfg.max_backends_per_se;
+			if (amdgpu::gfx_get_gb_addr_config(probe, cfg) != kIOReturnSuccess) {
+				N48LOG("geometry: GB_ADDR_CONFIG unreadable — the register refused a decode");
+			} else {
+				N48LOG("geometry: GB_ADDR_CONFIG=0x%08x -> %u SE, %u RB/SE, %u pipes, %u PKRs, "
+				       "interleave %u B, %u frags (die caps were %u SE / %u RB/SE)",
+				       cfg.gb_addr_config_raw, cfg.num_shader_engines, cfg.num_rb_per_se,
+				       cfg.num_pipes, cfg.num_pkrs, cfg.pipe_interleave_size,
+				       cfg.max_compressed_frags, expSE, expRB);
+				setProperty("GB_ADDR,Config", static_cast<uint64_t>(cfg.gb_addr_config_raw), 32);
+				setProperty("GB_ADDR,ShaderEngines", static_cast<uint64_t>(cfg.num_shader_engines), 32);
+				setProperty("GB_ADDR,RBPerSE", static_cast<uint64_t>(cfg.num_rb_per_se), 32);
+				setProperty("GB_ADDR,Pipes", static_cast<uint64_t>(cfg.num_pipes), 32);
+				setProperty("GB_ADDR,Pkrs", static_cast<uint64_t>(cfg.num_pkrs), 32);
+				setProperty("GB_ADDR,InterleaveBytes", static_cast<uint64_t>(cfg.pipe_interleave_size), 32);
+				setProperty("GB_ADDR,MaxCompressedFrags", static_cast<uint64_t>(cfg.max_compressed_frags), 32);
+				setProperty("GB_ADDR,ExpectedSE", static_cast<uint64_t>(expSE), 32);
+				setProperty("GB_ADDR,ExpectedRBPerSE", static_cast<uint64_t>(expRB), 32);
+				setProperty("GB_ADDR,SE_Match", cfg.num_shader_engines == expSE);
+				setProperty("GB_ADDR,RB_Match", cfg.num_rb_per_se == expRB);
+			}
+		}
+	}
+
+	const uint32_t fbBase = regReadIp(IpDiscovery::HwMmhub, 0, 0, n48::kFbLocationBaseDword);
+	const uint32_t fbTop  = regReadIp(IpDiscovery::HwMmhub, 0, 0, n48::kFbLocationTopDword);
+	if (fbBase == 0xFFFFFFFF || fbTop == 0xFFFFFFFF) {
+		N48LOG("geometry: MMHUB FB_LOCATION unreadable — the stages cannot build a device context either");
+		return;
+	}
+	const uint64_t mcBase = static_cast<uint64_t>(fbBase & n48::kFbLocationMask) << 24;
+	const uint64_t mcTop  = static_cast<uint64_t>(fbTop & n48::kFbLocationMask) << 24;
+	N48LOG("geometry: FB_LOCATION base=0x%08x top=0x%08x -> VRAM MC 0x%llx .. one page below 0x%llx",
+	       fbBase, fbTop, mcBase, mcTop);
+	setProperty("MMHUB,FBLocationBase", static_cast<uint64_t>(fbBase), 32);
+	setProperty("MMHUB,FBLocationTop", static_cast<uint64_t>(fbTop), 32);
+	setProperty("MMHUB,McBase", mcBase, 64);
+	setProperty("MMHUB,McTop", mcTop, 64);
+}
