+// ---------------------------------------------------------------------------
+// surveyDcn — the DMU segment bases, and whether the display write allowlist
+// would arm for them. Both read-only: dcn41_allow_init does no register I/O at
+// all, it only compares the bases this die reports with the ones the generated
+// range table was built for (dcn41_allow.c:79-84).
+//
+// This is the display layer's single hard precondition. A Navi 44 that reports
+// anything other than 0x12 / 0xc0 / 0x34c0 / 0x9000 / 0x2403c00 leaves the
+// allowlist unarmed and the whole display path INERT (DCN41_E_BASES), which is
+// safe but silent — the property makes it visible without booting a stage.
+// ---------------------------------------------------------------------------
+void Navi48Bringup::surveyDcn() {
+	IpDiscovery::IpEntry e {};
+	if (!ipDiscovery.findIp(IpDiscovery::HwDmu, 0, e)) {
+		N48LOG("dcn-survey: no DMU (hwId 271) entry in discovery — display layer cannot resolve bases");
+		return;
+	}
+	char key[16], segs[192];
+	size_t n = 0;
+	segs[0] = '\0';
+	const uint8_t shown = e.numBases < DCN41_NUM_SEGS ? e.numBases : (uint8_t)DCN41_NUM_SEGS;
+	for (uint8_t s = 0; s < shown; s++) {
+		snprintf(key, sizeof(key), "DMU,Seg%u", s);
+		setProperty(key, static_cast<uint64_t>(e.bases[s]), 32);
+		n += snprintf(segs + n, sizeof(segs) - n, s ? " %08x" : "%08x", e.bases[s]);
+	}
+	setProperty("DMU,SegCount", static_cast<uint64_t>(e.numBases), 8);
+	setProperty("DMU,Segs", segs);
+	if (e.numBases < DCN41_NUM_SEGS) {
+		N48LOG("dcn-survey: DMU reports %u segments; the display layer needs %u — allowlist cannot arm",
+		       e.numBases, DCN41_NUM_SEGS);
+		setProperty("DMU,AllowlistArms", false);
+		return;
+	}
+	dcn41_allow_state st {};
+	const int rc = dcn41_allow_init(&st, e.bases, static_cast<uint32_t>(rmmioSize / 4));
+	N48LOG("dcn-survey: allowlist would %s for segs %08x %08x %08x %08x %08x, BAR5 %u dwords (%s)",
+	       rc == DCN41_ALLOW_OK ? "ARM" : "REFUSE", e.bases[0], e.bases[1], e.bases[2], e.bases[3],
+	       e.bases[4], static_cast<uint32_t>(rmmioSize / 4), dcn41_allow_reason_name(rc));
+	setProperty("DMU,AllowlistArms", rc == DCN41_ALLOW_OK);
+	setProperty("DMU,AllowlistReason", dcn41_allow_reason_name(rc));
+}
