+
+inline uint64_t fat32_cluster_offset(const Fat32Geometry &g, uint32_t cluster) {
+    return g.dataStart + (uint64_t)(cluster - 2) * g.clusterBytes;
+}
+
+inline bool fat32_cluster_in_fat(const Fat32Geometry &g, uint32_t cluster) {
+    return (uint64_t)cluster * 4 + 4 <= (uint64_t)g.fatSizeSectors * g.bytesPerSector;
