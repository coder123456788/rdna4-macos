+inline bool fat32_chain_ok(uint32_t c) { return c >= 2 && c < 0x0FFFFFF7u; }
+
+// The whole write-safety condition in one place: a cluster inside the FAT, a file big enough for
+// the fixed write, and a byte offset that ends inside the partition.
+inline bool fat32_file_target(const Fat32Geometry &g, uint32_t firstCluster, uint32_t fileSize,
+                              uint32_t writeLen, uint64_t *offset) {
+    if (!g.valid || firstCluster < 2 || writeLen == 0) return false;
+    if (!fat32_cluster_in_fat(g, firstCluster)) return false;
+    if (fileSize < writeLen || g.clusterBytes < writeLen) return false;
+    const uint64_t off = fat32_cluster_offset(g, firstCluster);
+    if (off + writeLen > g.mediaBytes) return false;
+    if (offset) *offset = off;
+    return true;
+}
