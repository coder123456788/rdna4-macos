diff --git a/src/navi48-bringup/src/accel_report_raw.cpp b/src/navi48-bringup/src/accel_report_raw.cpp
new file mode 100644
index 0000000..3429ec4
--- /dev/null
+++ b/src/navi48-bringup/src/accel_report_raw.cpp
@@ -0,0 +1,176 @@
+//  accel_report_raw.cpp — patch 0028: the report reaches the stick without a mount.
+//
+//  Why not just the VFS: 0027's write needed diskarbitrationd to mount the FAT32 volume, and this
+//  machine produced boots where nothing was mounted, so nothing came back. The storage stack
+//  itself is always there - OpenCore booted from this stick - so the fallback opens the partition
+//  as an IOMedia and writes the report into the one file the kit pre-creates for it.
+//
+//  What keeps that safe: the media must parse as FAT32 with the OPENCORE label, the root
+//  directory must hold the exact 8.3 entry NAVI48.TXT, the entry must describe a file big enough
+//  for the fixed write, and the file's first bytes must be "navi". Only the first write length of
+//  that file's data cluster is written; no FAT, directory or other cluster is ever touched. A
+//  media that fails any check is left exactly as it was.
+
+#include "accel_report_raw.h"
+
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+#include <IOKit/storage/IOMedia.h>
+#include <IOKit/storage/IOStorage.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSIterator.h>
+#include <string.h>
+
+namespace {
+
+constexpr size_t kProbeBytes = 512;  // enough for the BPB, the label and a FAT entry
+
+IOReturn read_at(IOStorage *media, IOService *client, uint64_t offset, void *out, size_t len) {
+    IOBufferMemoryDescriptor *md =
+        IOBufferMemoryDescriptor::withCapacity((vm_size_t)len, kIODirectionIn, false);
+    if (!md) return kIOReturnNoMemory;
+    UInt64 actual = 0;
+    const IOReturn kr = media->read(client, offset, md, nullptr, &actual);
+    const void *src = md->getBytesNoCopy();
+    const bool ok = kr == kIOReturnSuccess && src && actual >= (UInt64)len;
+    if (ok) memcpy(out, src, len);
+    md->release();
+    return ok ? kIOReturnSuccess : kIOReturnError;
+}
+
+// Reader-level probe: the media is only trusted after its own sector 0 describes this kit's stick.
+bool stick_geometry(IOMedia *media, IOService *client, n48::Fat32Geometry *out) {
+    const UInt64 size = media->getSize();
+    if (size < n48::kRawReportMinMediaBytes || size > n48::kRawReportMaxMediaBytes) return false;
+    if (!media->open(client, 0, kIOStorageAccessReader)) return false;
+    uint8_t boot[kProbeBytes];
+    n48::Fat32Geometry g = {};
+    bool ok = read_at(media, client, 0, boot, sizeof boot) == kIOReturnSuccess;
+    if (ok) {
+        g = n48::fat32_parse_bpb(boot, sizeof boot, size);
+        ok = g.valid && n48::fat32_label_matches(boot, sizeof boot, n48::kRawReportLabel);
+    }
+    media->close(client, 0);
+    if (ok) *out = g;
+    return ok;
+}
+
+int fat_entry(IOStorage *media, IOService *client, const n48::Fat32Geometry &g, uint32_t cluster,
+              uint32_t *value) {
+    const uint64_t off = g.fatStart + (uint64_t)cluster * 4;
+    if (off + 4 > g.fatStart + (uint64_t)g.fatSizeSectors * g.bytesPerSector)
+        return n48::kRawIoError;
+    uint8_t sector[kProbeBytes];
+    const uint64_t aligned = off & ~(uint64_t)(kProbeBytes - 1);
+    if (read_at(media, client, aligned, sector, sizeof sector) != kIOReturnSuccess)
+        return n48::kRawIoError;
+    *value = n48::fat32_chain_value(n48::raw_rd32(sector + (uint32_t)(off - aligned)));
+    return n48::kRawOk;
+}
+
+// The root directory is a cluster chain; walk it (at most kRawReportMaxChainClusters) until the
+// entry appears, the 0x00 terminator ends the directory, or the chain does.
+int find_file(IOStorage *media, IOService *client, const n48::Fat32Geometry &g,
+              n48::Fat32DirHit *hit) {
+    uint32_t cluster = g.rootCluster;
+    for (uint32_t hops = 0; hops < n48::kRawReportMaxChainClusters; hops++) {
+        if (!n48::fat32_cluster_in_fat(g, cluster)) return n48::kRawIoError;
+        const uint64_t off = n48::fat32_cluster_offset(g, cluster);
+        if (off + g.clusterBytes > g.mediaBytes) return n48::kRawIoError;
+        IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::withCapacity(
+            (vm_size_t)g.clusterBytes, kIODirectionIn, false);
+        if (!md) return n48::kRawIoError;
+        UInt64 actual = 0;
+        const IOReturn kr = media->read(client, off, md, nullptr, &actual);
+        const uint8_t *p = (const uint8_t *)md->getBytesNoCopy();
+        n48::Fat32DirHit h = {};
+        if (kr == kIOReturnSuccess && p && actual >= g.clusterBytes)
+            h = n48::fat32_scan_dir(p, (size_t)g.clusterBytes, n48::kRawReportName);
+        md->release();
+        if (kr != kIOReturnSuccess) return n48::kRawIoError;
+        if (h.found || h.end) {
+            *hit = h;
+            return n48::kRawOk;
+        }
+        uint32_t next = 0;
+        const int err = fat_entry(media, client, g, cluster, &next);
+        if (err != n48::kRawOk) return err;
+        if (!n48::fat32_chain_ok(next)) return n48::kRawOk;  // hit stays empty: no such file
+        cluster = next;
+    }
+    return n48::kRawOk;
+}
+
+int write_to_stick(IOMedia *media, IOService *client, const n48::Fat32Geometry &g,
+                   const char *text, size_t len) {
+    n48::Fat32DirHit hit = {};
+    int err = find_file(media, client, g, &hit);
+    if (err != n48::kRawOk) return err;
+    if (!hit.found) return n48::kRawNoFile;
+
+    uint64_t fileOff = 0;
+    if (!n48::fat32_file_target(g, hit.firstCluster, hit.fileSize, (uint32_t)len, &fileOff))
+        return n48::kRawNoFile;
+
+    uint8_t head[kProbeBytes];
+    if (read_at(media, client, fileOff, head, sizeof head) != kIOReturnSuccess)
+        return n48::kRawIoError;
+    for (int i = 0; i < 4; i++) {
+        if (head[i] != n48::kRawReportMagic[i]) return n48::kRawBadMagic;
+    }
+
+    // Block devices take sector multiples; the pad bytes are spaces so the visible text is clean.
+    const uint64_t aligned =
+        ((uint64_t)len + g.bytesPerSector - 1) / g.bytesPerSector * g.bytesPerSector;
+    if (aligned > hit.fileSize || aligned > g.clusterBytes) return n48::kRawNoFile;
+
+    if (!media->open(client, 0, kIOStorageAccessReaderWriter)) return n48::kRawIoError;
+    int result = n48::kRawIoError;
+    IOBufferMemoryDescriptor *out =
+        IOBufferMemoryDescriptor::withCapacity((vm_size_t)aligned, kIODirectionOut, false);
+    if (out) {
+        uint8_t *p = (uint8_t *)out->getBytesNoCopy();
+        if (p) {
+            memcpy(p, text, len);
+            memset(p + len, ' ', (size_t)(aligned - len));
+            UInt64 actual = 0;
+            const IOReturn kr = media->write(client, fileOff, out, nullptr, &actual);
+            if (kr == kIOReturnSuccess && actual == aligned) {
+                media->synchronize(client, fileOff, aligned);  // best effort; data is out
+                result = n48::kRawOk;
+            }
+        }
+        out->release();
+    }
+    media->close(client, 0);
+    return result;
+}
+
+} // namespace
+
+namespace n48 {
+
+int report_raw_write(::IOService *client, const char *text, size_t len) {
+    if (!client || !text || len == 0 || len > kReportFileWriteCap) return kRawBadArgs;
+    OSDictionary *match = ::IOService::serviceMatching("IOMedia");
+    if (!match) return kRawNoStick;
+    OSIterator *it = ::IOService::getMatchingServices(match);
+    match->release();
+    if (!it) return kRawNoStick;
+
+    int result = kRawNoStick;
+    while (::IOService *svc = (::IOService *)it->getNextObject()) {
+        IOMedia *media = OSDynamicCast(IOMedia, svc);
+        if (!media) continue;
+        Fat32Geometry g = {};
+        if (!stick_geometry(media, client, &g)) continue;
+        result = write_to_stick(media, client, g, text, len);
+        if (result == kRawOk) break;
+    }
+    it->release();
+    return result;
+}
+
+} // namespace n48
diff --git a/src/navi48-bringup/src/accel_report_raw.h b/src/navi48-bringup/src/accel_report_raw.h
new file mode 100644
index 0000000..4d4ab6f
--- /dev/null
+++ b/src/navi48-bringup/src/accel_report_raw.h
@@ -0,0 +1,206 @@
+//  accel_report_raw.h — patch 0028: the verdict reaches the stick even when macOS never mounts it.
+//
+//  0027 wrote the report to /Volumes/OPENCORE, which needs diskarbitrationd to mount the FAT32
+//  volume. A boot where that never happens leaves nothing behind, and this machine has no other
+//  way to carry an answer back. So the same text now also goes straight into the file's data
+//  cluster through the block device: no mount, no filesystem driver, no VFS.
+//
+//  A raw write is only safe when it cannot land anywhere but one file this kit made for it, so
+//  the runtime accepts a device only after five checks: the IOMedia is in the stick's size class,
+//  sector 0 parses as a FAT32 BPB, the volume label is OPENCORE, the root directory holds the 8.3
+//  entry NAVI48.TXT, and that file's first four bytes are "navi". Only the first bytes of that one
+//  file are written; the FAT, the root directory and every other cluster stay read-only.
+//
+//  The FAT32 parsing lives here, with no IOKit, so the host suite can feed it synthetic sectors.
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "accel_report_file.h"
+
+class IOService;  // the IOStorage open() client; IOKit defines it, this header stays IOKit-free
+
+namespace n48 {
+
+enum : int {
+    kRawOk = 0,
+    kRawNoStick = -1,  // no media in the stick size class carried the FAT32 BPB + OPENCORE label
+    kRawNoFile = -2,   // the root directory has no NAVI48.TXT of the size this kit creates
+    kRawBadMagic = -3, // NAVI48.TXT exists but does not start with "navi" - not this kit's file
+    kRawIoError = -4,  // an open/read/write through the media failed
+    kRawBadArgs = -5,  // len outside (0, kReportFileWriteCap]
+};
+
+// "navi": the first four bytes of every report this kit writes, so the file is proof of its author
+// both on the Windows-created target and after an earlier boot overwrote it.
+constexpr uint8_t kRawReportMagic[4] = { 'n', 'a', 'v', 'i' };
+constexpr char kRawReportName[11] = { 'N', 'A', 'V', 'I', '4', '8', ' ', ' ', 'T', 'X', 'T' };
+constexpr char kRawReportLabel[11] = { 'O', 'P', 'E', 'N', 'C', 'O', 'R', 'E', ' ', ' ', ' ' };
+constexpr uint64_t kRawReportMinMediaBytes = 1ull << 30;
+constexpr uint64_t kRawReportMaxMediaBytes = 128ull << 30;
+constexpr uint32_t kRawReportMaxClusterBytes = 16384;
+constexpr uint32_t kRawReportMaxChainClusters = 64;
+
+struct Fat32Geometry {
+    uint32_t bytesPerSector;
+    uint32_t sectorsPerCluster;
+    uint32_t reservedSectors;
+    uint32_t fatCount;
+    uint32_t fatSizeSectors;
+    uint32_t rootCluster;
+    uint32_t totalSectors;
+    uint64_t fatStart;    // byte offset of FAT 0
+    uint64_t dataStart;   // byte offset of cluster 2 ("the data region")
+    uint64_t clusterBytes;
+    uint64_t mediaBytes;  // what IOMedia said the partition holds
+    bool valid;
+};
+
+struct Fat32DirHit {
+    uint32_t firstCluster;
+    uint32_t fileSize;
+    uint32_t entryOffset;  // byte offset of the 32-byte entry inside the cluster scanned
+    bool found;
+    bool end;              // a 0x00 entry ended the directory before a match
+};
+
+inline uint16_t raw_rd16(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+inline uint32_t raw_rd32(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+           ((uint32_t)p[3] << 24);
+}
+
+// Sector 0 of a FAT32 partition: the BPB, plus the "FAT32" string and the label the formatter
+// left there. Every field is bounds-checked against the media size, so a plausible-looking MBR or
+// an exFAT/exFAT-plus boot sector cannot pass as this filesystem.
+inline Fat32Geometry fat32_parse_bpb(const uint8_t *s, size_t len, uint64_t mediaBytes) {
+    Fat32Geometry g = {};
+    if (!s || len < 512 || s[510] != 0x55 || s[511] != 0xAA) return g;
+    g.bytesPerSector = raw_rd16(s + 0x0B);
+    g.sectorsPerCluster = s[0x0D];
+    g.reservedSectors = raw_rd16(s + 0x0E);
+    g.fatCount = s[0x10];
+    const uint32_t rootEntries = raw_rd16(s + 0x11);
+    const uint32_t total16 = raw_rd16(s + 0x13);
+    const uint32_t fat16 = raw_rd16(s + 0x16);
+    g.totalSectors = total16 ? total16 : raw_rd32(s + 0x20);
+    g.fatSizeSectors = fat16 ? fat16 : raw_rd32(s + 0x24);
+    g.rootCluster = raw_rd32(s + 0x2C);
+    g.mediaBytes = mediaBytes;
+
+    // FAT32 is exactly the layout where the 16-bit FAT size is 0 and the root is a cluster chain.
+    if (fat16 != 0 || rootEntries != 0 || g.fatSizeSectors == 0) return g;
+    if (s[0x52] != 'F' || s[0x53] != 'A' || s[0x54] != 'T' || s[0x55] != '3' || s[0x56] != '2')
+        return g;
+    if (g.bytesPerSector < 512 || g.bytesPerSector > 4096 ||
+        (g.bytesPerSector & (g.bytesPerSector - 1)) != 0)
+        return g;
+    if (g.sectorsPerCluster == 0 || g.sectorsPerCluster > 128 ||
+        (g.sectorsPerCluster & (g.sectorsPerCluster - 1)) != 0)
+        return g;
+    if (g.reservedSectors == 0 || g.fatCount == 0 || g.fatCount > 4) return g;
+    if (g.rootCluster < 2 || g.totalSectors == 0) return g;
+
+    g.clusterBytes = (uint64_t)g.bytesPerSector * g.sectorsPerCluster;
+    g.fatStart = (uint64_t)g.reservedSectors * g.bytesPerSector;
+    g.dataStart = (uint64_t)(g.reservedSectors + (uint64_t)g.fatCount * g.fatSizeSectors) *
+                  g.bytesPerSector;
+    const uint64_t fatBytes = (uint64_t)g.fatSizeSectors * g.bytesPerSector;
+    const uint64_t totalBytes = (uint64_t)g.totalSectors * g.bytesPerSector;
+    if (g.dataStart > totalBytes) return g;
+    if (mediaBytes != 0 && totalBytes > mediaBytes) return g;
+    if ((uint64_t)g.rootCluster * 4 + 4 > fatBytes) return g;
+    const uint64_t rootOffset = g.dataStart + (uint64_t)(g.rootCluster - 2) * g.clusterBytes;
+    if (rootOffset + g.clusterBytes > totalBytes) return g;
+    if (mediaBytes != 0 && rootOffset + g.clusterBytes > mediaBytes) return g;
+    g.valid = true;
+    return g;
+}
+
+// The formatter's label, compared without caring about case (FAT stores it uppercase).
+inline bool fat32_label_matches(const uint8_t *s, size_t len, const char *label) {
+    if (!s || !label || len < 0x52) return false;
+    for (int i = 0; i < 11; i++) {
+        uint8_t a = s[0x47 + i];
+        uint8_t b = (uint8_t)label[i];
+        if (a >= 'a' && a <= 'z') a = (uint8_t)(a - 32);
+        if (b >= 'a' && b <= 'z') b = (uint8_t)(b - 32);
+        if (a != b) return false;
+    }
+    return true;
+}
+
+// One 32-byte entry per iteration. Long-name fragments, deleted entries, volume labels and
+// subdirectories are skipped; the 0x00 terminator means no later entry can match.
+inline Fat32DirHit fat32_scan_dir(const uint8_t *dir, size_t len, const char *name11) {
+    Fat32DirHit hit = {};
+    if (!dir || !name11) return hit;
+    const size_t count = len / 32;
+    for (size_t i = 0; i < count; i++) {
+        const uint8_t *e = dir + i * 32;
+        if (e[0] == 0x00) {
+            hit.end = true;
+            return hit;
+        }
+        if (e[0] == 0xE5) continue;
+        const uint8_t attr = e[0x0B];
+        if ((attr & 0x3F) == 0x0F) continue;  // long-file-name fragment
+        if (attr & 0x18) continue;            // volume id or directory
+        bool same = true;
+        for (int k = 0; k < 11; k++) {
+            if (e[k] != (uint8_t)name11[k]) {
+                same = false;
+                break;
+            }
+        }
+        if (!same) continue;
+        hit.found = true;
+        hit.firstCluster = (uint32_t)raw_rd16(e + 0x1A) | ((uint32_t)raw_rd16(e + 0x14) << 16);
+        hit.fileSize = raw_rd32(e + 0x1C);
+        hit.entryOffset = (uint32_t)(i * 32);
+        return hit;
+    }
