+    case kRawNoFile: return "NAVI48.TXT is not in the root directory (or is not the size this kit creates)";
+    case kRawBadMagic: return "NAVI48.TXT does not start with navi - not this kit's file";
+    case kRawIoError: return "a storage open/read/write failed";
+    default: return "bad arguments";
+    }
