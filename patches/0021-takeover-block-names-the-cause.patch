diff --git a/src/navi48-bringup/src/accel_takeover.cpp b/src/navi48-bringup/src/accel_takeover.cpp
index c169452..046a8dd 100644
--- a/src/navi48-bringup/src/accel_takeover.cpp
+++ b/src/navi48-bringup/src/accel_takeover.cpp
@@ -11,7 +11,10 @@
 
 #include "amd/n48log.h"
 #include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
 #include <kern/thread.h>
+#include <libkern/c++/OSMetaClass.h>
+#include <libkern/c++/OSSymbol.h>
 
 #define TAKELOG(fmt, ...) ::amdgpu::n48_logf("takeover: " fmt "\n", ##__VA_ARGS__)
 
@@ -20,8 +23,51 @@ namespace {
 volatile uint32_t gArmed;
 volatile uint32_t gStarted;
 volatile uint32_t gBlockPrinted;
+volatile uintptr_t gProvider;
 
-void print_block(n48::TakeoverVerdict v, uint32_t waited) {
+bool text_contains(const char *hay, const char *needle) {
+    if (!hay || !needle) return false;
+    for (const char *h = hay; *h; h++) {
+        const char *a = h, *b = needle;
+        while (*a && *b && *a == *b) { a++; b++; }
+        if (!*b) return true;
+    }
+    return false;
+}
+
+// The class we instantiate can only be registered while Apple's kext is loaded, so this is
+// the "is there an accelerator to attach" question, asked without OSKext (not in the SDK).
+bool apple_kext_loaded() {
+    const OSSymbol *sym =
+        OSSymbol::withCStringNoCopy("AMDRadeonX6000_AMDNavi21GraphicsAccelerator");
+    if (!sym) return false;
+    const bool present = OSMetaClass::getMetaClassWithName(sym) != nullptr;
+    sym->release();
+    return present;
+}
+
+bool accel_attached() {
+    IOService *prov = (IOService *)__atomic_load_n(&gProvider, __ATOMIC_ACQUIRE);
+    if (!prov) return false;
+    OSIterator *it = prov->getChildIterator(gIOServicePlane);
+    if (!it) return false;
+    bool found = false;
+    while (IOService *c = (IOService *)it->getNextObject()) {
+        const char *cn = c->getMetaClass()->getClassName();
+        if (text_contains(cn, "Accelerator")) { found = true; break; }
+    }
+    it->release();
+    return found;
+}
+
+n48::TakeoverFacts gather_facts() {
+    n48::TakeoverFacts f;
+    f.appleKextLoaded = apple_kext_loaded();
+    f.accelAttached = accel_attached();
+    return f;
+}
+
+void print_block(n48::TakeoverVerdict v, uint32_t waited, const n48::TakeoverFacts &f) {
     for (uint32_t t = 0; t <= n48::kTakeoverHold; t++) {
         TAKELOG("========== NAVI 44 TAKEOVER REPORT %u/%u ==========", t, n48::kTakeoverHold);
         TAKELOG("%s", n48::accel_takeover_headline(v));
@@ -31,6 +77,9 @@ void print_block(n48::TakeoverVerdict v, uint32_t waited) {
         } else {
             TAKELOG("waited %u s after LoadAccelerator was published; no SpecialAMDKey type 0x00 "
                     "arrived from Apple's accelerator", waited);
+            TAKELOG("%s", n48::accel_takeover_diagnosis(f));
+            TAKELOG("kext loaded=%u  accelerator child=%u", f.appleKextLoaded ? 1u : 0u,
+                    f.accelAttached ? 1u : 0u);
         }
         TAKELOG("no terminal needed: photograph this screen");
         if (t >= n48::kTakeoverHold) break;
@@ -51,14 +100,17 @@ void takeover_poller(void *, wait_result_t) {
     if (v == n48::TakeoverVerdict::NotArmed) return;
     uint32_t expected = 0;
     if (!__atomic_compare_exchange_n(&gBlockPrinted, &expected, 1u, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return;
-    print_block(v, waited);
+    // Asked after the wait, not at arm time: a kext that loads late still counts.
+    const n48::TakeoverFacts facts = gather_facts();
+    print_block(v, waited, facts);
 }
 
 } // namespace
 
 namespace n48 {
 
-void takeover_arm() {
+void takeover_arm(::IOService *provider) {
+    __atomic_store_n(&gProvider, (uintptr_t)provider, __ATOMIC_RELEASE);
     __atomic_store_n(&gArmed, 1u, __ATOMIC_RELEASE);
 }
 
diff --git a/src/navi48-bringup/src/accel_takeover_report.h b/src/navi48-bringup/src/accel_takeover_report.h
index b0b5d96..071523a 100644
--- a/src/navi48-bringup/src/accel_takeover_report.h
+++ b/src/navi48-bringup/src/accel_takeover_report.h
@@ -21,6 +21,8 @@
 
 #include <stdint.h>
 
+class IOService;   // global: the runtime takes the card as a plain IOService
+
 namespace n48 {
 
 constexpr uint32_t kTakeoverWaitSeconds = 20;  // 1 s steps; the 0019 hold runs out first
@@ -43,15 +45,35 @@ inline const char *accel_takeover_headline(TakeoverVerdict v) {
         return "TAKEOVER: Apple's accelerator started - the handover happened";
     case TakeoverVerdict::TimedOut:
         return "NO TAKEOVER: LoadAccelerator was published but Apple's accelerator never "
-               "announced itself - its personality did not match this card's device id";
+               "announced itself - the line below names the reason";
     case TakeoverVerdict::NotArmed:
         return "takeover: not tracked - the report was not requested, or nothing was published";
     }
     return "takeover: unknown verdict";
 }
 
+//  A timeout is one bit; it has three causes and they need different fixes. Without these
+//  facts the block can only guess, and guessing "the id did not match" on a boot whose
+//  system has no accelerator kext at all (every recovery boot) sends the owner to the
+//  wrong fix.
+struct TakeoverFacts {
+    bool appleKextLoaded;  // com.apple.kext.AMDRadeonX6000 is loaded on this boot
+    bool accelAttached;    // a child of the card has "Accelerator" in its class name
+};
+
+inline const char *accel_takeover_diagnosis(const TakeoverFacts &f) {
+    if (!f.appleKextLoaded)
+        return "cause: Apple's AMDRadeonX6000 kext is not loaded on this boot, so there is "
+               "no accelerator class to attach - as on a recovery boot";
+    if (f.accelAttached)
+        return "cause: Apple's accelerator attached to this card but its start() failed "
+               "before it announced itself - the personality matched, the bring-up did not";
+    return "cause: Apple's AMDRadeonX6000 kext is loaded but nothing attached to this card "
+           "- its personality did not match the device id Apple sees";
+}
+
 // ---- runtime, defined in accel_takeover.cpp ----
-void takeover_arm();
+void takeover_arm(::IOService *provider);
 void takeover_mark_started(void *accel);
 void takeover_start_poller();
 
