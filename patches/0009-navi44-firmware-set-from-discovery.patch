+// ---------------------------------------------------------------------------
+// selectFwFromDiscovery — which die's firmware this card gets, decided by the
+// die rather than by its PCI id.
+//
+// probe() picks the set from device_id because it runs before there is anything
+// to read, and its allowlist names exactly three ids. A Navi 44 that shows up
+// under a fourth — the RX 9050's OEM SKUs, whatever ships next — would be handed
+// Navi 48's gc_12_0_1 + psp_14_0_3 + smu_14_0_3 blobs. Nothing would complain
+// until the PSP chain starts refusing TMR-resident LOAD_IP_FW with
+// TEE_BAD_PARAMETERS, three stages downstream of a decision taken in the wrong
+// order. Discovery has been able to name the die since the first survey, so
+// name it here, before any stage can ask for a blob.
+//
+// The window where this is free is exactly here: fw_get() builds the table
+// lazily, so no FwBlob has been handed out yet and none can go stale under us.
+// ---------------------------------------------------------------------------
+void Navi48Bringup::selectFwFromDiscovery() {
+	amdgpu::IPBaseTable ip {};
+	// The return value says whether every block's *bases* resolved. This call
+	// only needs the three versions, and fw_select_from_ip() checks those
+	// itself; a table missing, say, MMHUB is refused later by the stages that
+	// need that base, not by us.
+	const bool basesComplete = amdgpu::fill_ip_base_table(ipDiscovery, ip);
+	const amdgpu::IPVersion gc = ip.getVersion(amdgpu::IPBlock::GC),
+	                          mp0 = ip.getVersion(amdgpu::IPBlock::MP0),
+	                          mp1 = ip.getVersion(amdgpu::IPBlock::MP1);
+	const bool wasNavi44 = amdgpu::fw_is_navi44();
+
+	if (!amdgpu::fw_select_from_ip(gc, mp0, mp1)) {
+		N48LOG("fw-select: discovery reports GC %u.%u.%u / MP0 %u.%u.%u / MP1 %u.%u.%u, which is neither "
+		       "Navi 44 (12.0.0/14.0.2/14.0.2) nor Navi 48 (12.0.1/14.0.3/14.0.3) — keeping the PCI-id pick '%s', "
+		       "whose blobs are therefore an unverified guess",
+		       gc.major, gc.minor, gc.rev, mp0.major, mp0.minor, mp0.rev,
+		       mp1.major, mp1.minor, mp1.rev, amdgpu::fw_set_name());
+		setProperty("FW,SetSource", "PCI id, not confirmed by discovery");
+		return;
+	}
+	N48LOG("fw-select: firmware set '%s'%s from GC %u.%u.%u / MP0 %u.%u.%u / MP1 %u.%u.%u%s",
+	       amdgpu::fw_set_name(), wasNavi44 != amdgpu::fw_is_navi44() ? " — CORRECTED from the PCI-id guess" : "",
+	       gc.major, gc.minor, gc.rev, mp0.major, mp0.minor, mp0.rev, mp1.major, mp1.minor, mp1.rev,
+	       basesComplete ? "" : " (IP base table incomplete)");
+	setProperty("FW,Set", amdgpu::fw_set_name());
+	setProperty("FW,SetSource", "IP discovery");
+}
