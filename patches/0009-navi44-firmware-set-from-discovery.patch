+// The die is named by the version triple, and only by triples this table can
+// actually carry — deliberately not by arithmetic on the revisions. The two
+// known dies are GC 12.0.0 + PSP/SMU 14.0.2 (Navi 44) and GC 12.0.1 + 14.0.3
+// (Navi 48), which looks like "revision + 2", but linux-firmware also ships
+// psp_14_0_5 for parts with no GC 12.0.x / smu_14_0_5 counterpart here. A rule
+// derived from the pattern would happily select a set whose PSP blobs do not
+// match the silicon, which is the exact failure this function exists to catch.
+// Anything that is not one of the two rows below is refused, and the caller
+// keeps — and logs — the PCI-id guess.
+bool fw_select_from_ip(IPVersion gc, IPVersion mp0, IPVersion mp1) {
+    if (gc.major != 12 || gc.minor != 0 || mp0.major != 14 || mp0.minor != 0 ||
+        mp1.major != 14 || mp1.minor != 0)
+        return false;
+
+    if (gc.rev == 0 && mp0.rev == 2 && mp1.rev == 2) {
+        apply_set(kSetNavi44);
+        return true;
     }
+    if (gc.rev == 1 && mp0.rev == 3 && mp1.rev == 3) {
+        apply_set(kSetNavi48);
+        return true;
+    }
+    return false;
 }
 
 bool fw_is_navi44() {
     return g_set == kSetNavi44;
 }
 
+const char *fw_set_name() {
+    return fw_is_navi44() ? "navi44" : "navi48";
+}
