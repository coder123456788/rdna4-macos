 bool fill_ip_base_table(const IpDiscovery &disc, IPBaseTable &table);
 const char *ip_block_name(IPBlock b);
+
+// ---- 0011: the SDMA arm of the IP census --------------------------------
+// One {hw_id, instance_number} pair as the discovery table records it. Kept a
+// plain POD so the census can be driven from a synthetic table on the host —
+// forging a whole validated IPDS ROM image to test six lines of arithmetic
+// would be the kind of test that only proves the harness works.
+struct SdmaInstanceRef {
+    uint16_t hwId;
+    uint8_t  instance;
+};
+
+struct SdmaCensus {
+    uint32_t count;     // engines found
+    uint32_t mask;      // BIT(instance number) of every engine found
+    uint32_t overflow;  // engines past the array ceiling, counted but not usable
+};
+
+// The census itself — a direct port of the SDMA arm of the IP walk in
+// amdgpu_discovery.c:1916-1925: an entry is an SDMA engine when its hw_id is
+// one of SDMA0..3_HWID (42, 43, 68, 69 — soc15_hw_ip.h:59-60, 85-86), the
+// count rises once per entry while it fits under the cap, and the mask takes
+// the entry's instance number. Count and mask are separate for a reason: a die
+// that numbers its two engines 1 and 2 reports count 2 with mask 0b110, and
+// programming engine 0 as though it were engine 1 is exactly the failure a
+// silent `count` would hide.
+void sdma_census_add(SdmaCensus &c, uint16_t hwId, uint8_t instance);
+SdmaCensus sdma_census_from_entries(const SdmaInstanceRef *entries, uint32_t n);
+
+// Walk a parsed discovery table and feed the pairs to the census above. False
+// only when there is no valid table to walk, which the caller must treat as
+// "unknown", never as "zero engines".
+bool sdma_census(const IpDiscovery &disc, SdmaCensus &out);
 }
