 const Map kMap[] = {
     { IPBlock::GC,     kHwGc,     0, true  },
@@ -51,4 +55,51 @@ bool fill_ip_base_table(const IpDiscovery &disc, IPBaseTable &table) {
     return ok;
 }
 
+// ---- 0011: the SDMA arm of the IP census --------------------------------
+// Upstream, verbatim in shape (amdgpu_discovery.c:1916-1925):
+//
+//     if (hw_id == SDMA0_HWID || hw_id == SDMA1_HWID ||
+//         hw_id == SDMA2_HWID || hw_id == SDMA3_HWID) {
+//             if (adev->sdma.num_instances < AMDGPU_MAX_SDMA_INSTANCES) {
+//                     adev->sdma.num_instances++;
+//                     adev->sdma.sdma_mask |= (1U << ip->instance_number);
+//             } else
+//                     dev_err(... "Too many SDMA instances: %d vs %d\n" ...);
+//     }
+//
+// Two deviations, both deliberate and both visible in the log rather than
+// silent in the mask:
+//   * the shift is guarded at 32 bits. Upstream shifts a u32 by a value read
+//     straight out of the card's ROM, which is undefined behaviour for
+//     instance_number >= 32; the engine still counts, only the bit is dropped.
+//   * the over-cap case is counted into `overflow` instead of only printed, so
+//     the caller can refuse rather than bring up 16 engines and quietly lose
+//     the rest.
+void sdma_census_add(SdmaCensus &c, uint16_t hwId, uint8_t instance) {
+    if (hwId != kHwSdma0 && hwId != kHwSdma1 &&
+        hwId != kHwSdma2 && hwId != kHwSdma3)
+        return;
+    if (c.count >= kSDMAMaxInstances) { c.overflow++; return; }
+    c.count++;
+    if (instance < 32) c.mask |= (1u << instance);
+}
+
+SdmaCensus sdma_census_from_entries(const SdmaInstanceRef *entries, uint32_t n) {
+    SdmaCensus c = {};
+    for (uint32_t i = 0; i < n; i++)
+        sdma_census_add(c, entries[i].hwId, entries[i].instance);
+    return c;
+}
+
+bool sdma_census(const IpDiscovery &disc, SdmaCensus &out) {
+    out = SdmaCensus();
+    if (!disc.isValid()) return false;
+    IpDiscovery::IpEntry e;
+    for (uint16_t i = 0; i < disc.ipCount(); i++) {
+        if (!disc.ipAt(i, e)) break;      // a short/truncated walk: keep what we saw
+        sdma_census_add(out, e.hwId, e.instance);
+    }
+    return true;
+}
+
 } // namespace amdgpu
diff --git a/src/navi48-bringup/src/amd/amdgpu_discovery.h b/src/navi48-bringup/src/amd/amdgpu_discovery.h
index 121e3ff..3bd9274 100644
