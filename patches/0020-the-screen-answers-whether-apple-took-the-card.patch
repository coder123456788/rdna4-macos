diff --git a/src/navi48-bringup/src/accel_takeover.cpp b/src/navi48-bringup/src/accel_takeover.cpp
new file mode 100644
index 0000000..c169452
--- /dev/null
+++ b/src/navi48-bringup/src/accel_takeover.cpp
@@ -0,0 +1,85 @@
+//  0020 — the takeover watchdog. accel_takeover_report.h owns the decision; this file owns the
+//  two signals and the one thread that waits for the negative one.
+//
+//  Why a thread at all: the positive signal arrives on Apple's own registry thread, inside
+//  GraphicsAccelerator::start(). Nothing else in this kext is running at that point that could
+//  notice its absence — start() has returned from the fire call and the -v console is otherwise
+//  silent — so the only way to say "it never came" is to wait for it from a thread of our own.
+//  Same idiom as AppleHardwareHook.cpp's kIQ stamp poller: kernel_thread_start, deallocate, done.
+
+#include "accel_takeover_report.h"
+
+#include "amd/n48log.h"
+#include <IOKit/IOLib.h>
+#include <kern/thread.h>
+
+#define TAKELOG(fmt, ...) ::amdgpu::n48_logf("takeover: " fmt "\n", ##__VA_ARGS__)
+
+namespace {
+
+volatile uint32_t gArmed;
+volatile uint32_t gStarted;
+volatile uint32_t gBlockPrinted;
+
+void print_block(n48::TakeoverVerdict v, uint32_t waited) {
+    for (uint32_t t = 0; t <= n48::kTakeoverHold; t++) {
+        TAKELOG("========== NAVI 44 TAKEOVER REPORT %u/%u ==========", t, n48::kTakeoverHold);
+        TAKELOG("%s", n48::accel_takeover_headline(v));
+        if (v == n48::TakeoverVerdict::Started) {
+            TAKELOG("Apple's accelerator announced itself %u s after LoadAccelerator was "
+                    "published - it matched this card and ran its own start()", waited);
+        } else {
+            TAKELOG("waited %u s after LoadAccelerator was published; no SpecialAMDKey type 0x00 "
+                    "arrived from Apple's accelerator", waited);
+        }
+        TAKELOG("no terminal needed: photograph this screen");
+        if (t >= n48::kTakeoverHold) break;
+        IOSleep(1000);
+    }
+}
+
+void takeover_poller(void *, wait_result_t) {
+    uint32_t waited = 0;
+    while (waited < n48::kTakeoverWaitSeconds) {
+        IOSleep(1000);
+        waited++;
+        if (__atomic_load_n(&gStarted, __ATOMIC_ACQUIRE)) break;
+    }
+    const n48::TakeoverVerdict v =
+        n48::accel_takeover_verdict(__atomic_load_n(&gArmed, __ATOMIC_ACQUIRE) != 0,
+                                    __atomic_load_n(&gStarted, __ATOMIC_ACQUIRE) != 0);
+    if (v == n48::TakeoverVerdict::NotArmed) return;
+    uint32_t expected = 0;
+    if (!__atomic_compare_exchange_n(&gBlockPrinted, &expected, 1u, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return;
+    print_block(v, waited);
+}
+
+} // namespace
+
+namespace n48 {
+
+void takeover_arm() {
+    __atomic_store_n(&gArmed, 1u, __ATOMIC_RELEASE);
+}
+
+// Called from Apple's start() through SpecialAMDKey, so it must not sleep: the block is held
+// by the poller, whose thread is ours, not Apple's.
+void takeover_mark_started(void *accel) {
+    if (!__atomic_load_n(&gArmed, __ATOMIC_ACQUIRE)) return;
+    __atomic_store_n(&gStarted, 1u, __ATOMIC_RELEASE);
+    TAKELOG("Apple's accelerator announced itself over SpecialAMDKey 0x00 (accel=%p) - "
+            "the handover happened", accel);
+}
+
+void takeover_start_poller() {
+    thread_t th = nullptr;
+    const kern_return_t kr = kernel_thread_start(&takeover_poller, nullptr, &th);
+    if (kr != KERN_SUCCESS) {
+        TAKELOG("kernel_thread_start failed (0x%x) - no timeout report on this boot", kr);
+        return;
+    }
+    thread_deallocate(th);
+    TAKELOG("watching %u s for Apple's accelerator to announce itself", kTakeoverWaitSeconds);
+}
+
+} // namespace n48
diff --git a/src/navi48-bringup/src/accel_takeover_report.h b/src/navi48-bringup/src/accel_takeover_report.h
new file mode 100644
index 0000000..b0b5d96
--- /dev/null
+++ b/src/navi48-bringup/src/accel_takeover_report.h
@@ -0,0 +1,58 @@
+//  accel_takeover_report.h — patch 0020: did Apple's accelerator actually take the card?
+//
+//  0019 prints what this kext decided (was LoadAccelerator published, and why). That decision
+//  is necessary but not sufficient: Apple's accelerator personality carries an IOPCIMatch, and
+//  publishing LoadAccelerator only makes the card ELIGIBLE to match it. The question the boot
+//  screen has never answered is whether Apple's accelerator actually attached and reached the
+//  end of its own start().
+//
+//  The hardware answers it through two signals that already exist in this tree:
+//
+//    positive — GraphicsAccelerator::start() announces itself over SpecialAMDKey with type 0x00
+//               as the last thing before it decides whether it started
+//               (Navi48AccelPeer::handleSpecialAMDKey, kReqAccelStarted);
+//    negative — the wait below expires with no such call.
+//
+//  The negative signal is only meaningful if the card was actually offered: "Apple never
+//  started" on a boot that never published LoadAccelerator would blame the personality for the
+//  gate's decision. accel_takeover_armed() is that rule, and it is the one decision here that
+//  can produce a wrong verdict on its own.
+#pragma once
+
+#include <stdint.h>
+
+namespace n48 {
+
+constexpr uint32_t kTakeoverWaitSeconds = 20;  // 1 s steps; the 0019 hold runs out first
+constexpr uint32_t kTakeoverHold        = 5;   // repeats of the block, so a photograph catches it
+
+enum class TakeoverVerdict { NotArmed, Started, TimedOut };
+
+inline bool accel_takeover_armed(bool reportRequested, bool published) {
+    return reportRequested && published;
+}
+
+inline TakeoverVerdict accel_takeover_verdict(bool armed, bool appleStarted) {
+    if (!armed) return TakeoverVerdict::NotArmed;
+    return appleStarted ? TakeoverVerdict::Started : TakeoverVerdict::TimedOut;
+}
+
+inline const char *accel_takeover_headline(TakeoverVerdict v) {
+    switch (v) {
+    case TakeoverVerdict::Started:
+        return "TAKEOVER: Apple's accelerator started - the handover happened";
+    case TakeoverVerdict::TimedOut:
+        return "NO TAKEOVER: LoadAccelerator was published but Apple's accelerator never "
+               "announced itself - its personality did not match this card's device id";
+    case TakeoverVerdict::NotArmed:
+        return "takeover: not tracked - the report was not requested, or nothing was published";
+    }
+    return "takeover: unknown verdict";
+}
+
+// ---- runtime, defined in accel_takeover.cpp ----
+void takeover_arm();
+void takeover_mark_started(void *accel);
+void takeover_start_poller();
+
+} // namespace n48
